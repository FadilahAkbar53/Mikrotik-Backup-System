# Server Configuration
NODE_ENV=production
PORT=3000
APP_NAME="MikBack"

# IMPORTANT FOR VPS DEPLOYMENT:
# Ganti dengan domain produksi Anda (contoh: https://mikback.terrafa.tech)
# URL ini digunakan oleh generator script MikroTik agar router tahu alamat server upload tujuan.
APP_URL=https://mikback.terrafa.tech

# Security (Ganti dengan string rahasia acak yang kuat)
SESSION_SECRET=mikrotik_backup_express_super_secret_session_key_2026

# MySQL Database Configuration
# Jika database di VPS lokal gunakan 127.0.0.1, jika menggunakan database remote isi IP server remote tersebut.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikrotik_backup
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Storage Configuration
STORAGE_PATH=storage

# Queue Worker Concurrency (Batas backup yang diproses bersamaan, disarankan 2 - 4)
BACKUP_QUEUE_CONCURRENCY=2

# FTP Server Configuration (Untuk menerima upload native MikroTik .backup dan .rsc)
FTP_ENABLED=true
FTP_PORT=2121
# PENTING: Harus berupa IPv4 publik server VPS (bukan domain), sesuai RFC 959 PASV mode
FTP_PASV_URL=187.52.122.246
FTP_PASV_MIN=10000
FTP_PASV_MAX=10050

