<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div class="d-flex align-items-center gap-3">
        <a href="/routers" class="btn btn-light border btn-sm p-2 rounded-2 text-secondary" title="Kembali ke Daftar Router">
            <i class="bi bi-arrow-left fs-6"></i>
        </a>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h3 class="fw-bold mb-0 text-dark"><%= router.name %></h3>
                <% if (router.last_backup_time) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-check-circle-fill me-1"></i> Aktif
                    </span>
                <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small">
                        <i class="bi bi-dash-circle me-1"></i> Belum ada backup
                    </span>
                <% } %>
            </div>
            <p class="text-muted small mb-0">
                Pemilik: <span class="text-dark fw-medium"><%= router.owner_name || 'N/A' %></span>
                <% if (router.last_backup_time) { %>
                    &bull; Terakhir: <span class="text-dark fw-medium"><%= formatDate(router.last_backup_time) %> WIB</span> 
                    <span class="text-muted">(<%= diffForHumans(router.last_backup_time) %>)</span>
                <% } %>
            </p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1.5 rounded-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadManualBackupModal">
            <i class="bi bi-cloud-arrow-up-fill"></i>
            <span>Upload Backup Manual</span>
        </button>
        <a href="/routers/<%= router.id %>/edit" class="btn btn-light border btn-sm d-inline-flex align-items-center gap-1.5 rounded-2 text-secondary">
            <i class="bi bi-pencil"></i>
            <span>Edit</span>
        </a>
        <form action="/routers/<%= router.id %>/regenerate-token" method="POST" onsubmit="return confirm('Regenerate token akan membuat token lama tidak berlaku dan script pada MikroTik harus diperbarui. Lanjutkan?');">
            <button type="submit" class="btn btn-light border btn-sm d-inline-flex align-items-center gap-1.5 rounded-2 text-secondary" title="Buat token autentikasi baru">
                <i class="bi bi-arrow-repeat"></i>
                <span>Reset Token</span>
            </button>
        </form>
        <button type="button" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1.5 rounded-2" data-bs-toggle="modal" data-bs-target="#deleteRouterModal">
            <i class="bi bi-trash"></i>
            <span>Hapus</span>
        </button>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs border-bottom mb-4" id="routerDetailTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link <%= tab === 'backups' || tab === 'overview' ? 'active' : '' %> fw-semibold px-3 py-2.5 d-inline-flex align-items-center gap-2" href="/routers/<%= router.id %>?tab=backups">
            <i class="bi bi-folder2-open text-primary"></i>
            <span>Riwayat Backup</span>
            <span class="badge <%= totalBackups > 0 ? 'bg-primary-subtle text-primary' : 'bg-light text-muted border' %> rounded-pill px-2 py-0.5 small"><%= totalBackups %></span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link <%= tab === 'script' ? 'active' : '' %> fw-semibold px-3 py-2.5 d-inline-flex align-items-center gap-2" href="/routers/<%= router.id %>?tab=script">
            <i class="bi bi-terminal text-warning"></i>
            <span>Script Generator</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link <%= tab === 'api' ? 'active' : '' %> fw-semibold px-3 py-2.5 d-inline-flex align-items-center gap-2" href="/routers/<%= router.id %>?tab=api">
            <i class="bi bi-code-slash text-info"></i>
            <span>API & Integrasi</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link <%= tab === 'reports' ? 'active' : '' %> fw-semibold px-3 py-2.5 d-inline-flex align-items-center gap-2" href="/routers/<%= router.id %>?tab=reports">
            <i class="bi bi-receipt-cutoff text-success"></i>
            <span>Laporan Voucher</span>
        </a>
    </li>
</ul>

<!-- Tab Contents -->
<div class="tab-content">
    <% if (tab === 'script') { %>
        <!-- SCRIPT GENERATOR TAB -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-magic text-warning fs-5"></i>
                    <h5 class="fw-bold mb-0">MikroTik Script & Scheduler Generator</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="GET" action="/routers/<%= router.id %>" class="row g-3 mb-4">
                    <input type="hidden" name="tab" value="script">
                    <div class="col-md-5">
                        <label class="form-label fw-bold small text-dark">Pilih Template Script</label>
                        <select name="template_id" class="form-select form-select-sm" onchange="this.form.submit()">
                            <% templates.forEach(function(tpl) { %>
                                <option value="<%= tpl.id %>" <%= tpl.id === selectedTemplateId ? 'selected' : '' %>>
                                    <%= tpl.name %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-dark">Interval Scheduler</label>
                        <select name="interval" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="1d" <%= interval === '1d' ? 'selected' : '' %>>1 Hari Sekali (1d)</option>
                            <option value="12h" <%= interval === '12h' ? 'selected' : '' %>>12 Jam Sekali (12h)</option>
                            <option value="6h" <%= interval === '6h' ? 'selected' : '' %>>6 Jam Sekali (6h)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Jam Mulai (Start Time)</label>
                        <div class="input-group input-group-sm">
                            <input type="text" name="start_time" class="form-control" value="<%= startTime %>" placeholder="02:00:00">
                            <button type="submit" class="btn btn-outline-secondary">Terapkan</button>
                        </div>
                    </div>
                </form>

                <% if (activeTemplate) { %>
                    <div class="p-3 bg-light rounded-2 border mb-3 small text-muted">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <%= activeTemplate.description || 'Salin script di bawah ini ke terminal MikroTik RouterOS Anda.' %>
                    </div>
                <% } %>

                <div class="position-relative">
                    <button type="button" class="btn btn-sm btn-light border position-absolute top-0 end-0 m-3 d-inline-flex align-items-center gap-1 shadow-sm" onclick="copyScriptToClipboard()" id="copyScriptBtn">
                        <i class="bi bi-clipboard"></i> <span>Salin Script</span>
                    </button>
                    <pre class="code-box p-4" style="max-height: 400px; overflow-y: auto;" id="scriptPreContent"><code><%= generatedScript %></code></pre>
                </div>
            </div>
        </div>

    <% } else if (tab === 'api') { %>
        <!-- API & INTEGRASI TAB -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-code-slash text-info me-2"></i>Parameter Integrasi API</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Endpoint URL Upload</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace bg-light" value="<%= appUrl %>/api/backup/upload" readonly id="apiUrlInput">
                        <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('apiUrlInput').value); alert('URL disalin!');">
                            <i class="bi bi-clipboard"></i> Salin URL
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Router API Token</label>
                    <div class="input-group">
                        <input type="password" class="form-control font-monospace bg-light" value="<%= router.api_token %>" readonly id="apiTokenInput">
                        <button class="btn btn-outline-secondary" type="button" onclick="toggleTokenVisibility()">
                            <i class="bi bi-eye" id="tokenEyeIcon"></i>
                        </button>
                        <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('<%= router.api_token %>'); alert('Token disalin!');">
                            <i class="bi bi-clipboard"></i> Salin Token
                        </button>
                    </div>
                    <div class="form-text small text-muted">Gunakan token ini pada header <code>X-Router-Token</code> atau query param <code>?token=...</code> saat mengunggah file.</div>
                </div>

                <div class="p-3 bg-light rounded-2 border">
                    <h6 class="fw-bold mb-2 small text-uppercase text-dark">Contoh Request Curl</h6>
                    <pre class="code-box p-3 mb-0" style="font-size: 0.8rem;"><code>curl -X POST "<%= appUrl %>/api/backup/upload" \
  -H "X-Router-Token: <%= router.api_token %>" \
  -F "type=rsc" \
  -F "file=@backup.rsc"</code></pre>
                </div>
            </div>
        </div>

    <% } else if (tab === 'reports' && reportData) { %>
        <!-- HOTSPOT VOUCHER REPORT TAB -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <h5 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-receipt-cutoff text-success"></i>
                    <span>Laporan Voucher Hotspot: <%= router.name %></span>
                </h5>
                <p class="text-muted small mb-0">Diekstrak secara otomatis dari script Mikhmon pada berkas backup .rsc</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <form action="/reports/<%= router.id %>/sync" method="POST" class="m-0" id="syncReportForm">
                    <button type="submit" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" id="btnSyncReport" title="Pindai seluruh berkas .rsc untuk melengkapi tanggal yang terlewat tanpa duplikasi">
                        <i class="bi bi-arrow-repeat" id="syncIcon"></i> Sinkronkan Riwayat .RSC
                    </button>
                </form>
                <a href="/reports?router_id=<%= router.id %>" class="btn btn-sm btn-primary shadow-sm">
                    <i class="bi bi-arrows-fullscreen me-1"></i> Buka Halaman Laporan Penuh
                </a>
            </div>
        </div>

        <% if (reportData.summary.totalVouchers === 0) { %>
            <div class="alert alert-info border-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>
                        <strong>Belum Ada Data Voucher Hotspot untuk Router Ini</strong>
                        <div class="small text-muted">Laporan voucher diambil dari script Mikhmon (<code>comment=mikhmon</code>) pada backup <strong>.rsc</strong>.</div>
                    </div>
                </div>
                <form action="/reports/<%= router.id %>/sync" method="POST" class="m-0">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-cloud-arrow-down-fill me-1"></i> Sinkronkan Sekarang
                    </button>
                </form>
            </div>
        <% } %>

        <!-- Filter Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <form method="GET" action="/routers/<%= router.id %>" class="row g-2 align-items-center">
                    <input type="hidden" name="tab" value="reports">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Periode Bulan</label>
                        <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Semua Bulan (Keseluruhan)</option>
                            <% reportData.availableMonths.forEach(function(m) { %>
                                <option value="<%= m.value %>" <%= reportData.filters.month === m.value ? 'selected' : '' %>>
                                    <%= m.label %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Profil Voucher</label>
                        <select name="profile" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Semua Profil</option>
                            <% reportData.availableProfiles.forEach(function(p) { %>
                                <option value="<%= p %>" <%= reportData.filters.profile === p ? 'selected' : '' %>>
                                    <%= p %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted mb-1">Pencarian Voucher</label>
                        <div class="input-group input-group-sm">
                            <input type="text" name="report_search" class="form-control" placeholder="Kode, IP, MAC, komentar..." value="<%= reportData.filters.search || '' %>">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Cari</button>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end pt-3 pt-md-0">
                        <% if (reportData.filters.month || reportData.filters.profile || reportData.filters.search) { %>
                            <a href="/routers/<%= router.id %>?tab=reports" class="btn btn-sm btn-outline-danger w-100" title="Reset Filter">
                                <i class="bi bi-x-circle me-1"></i> Reset
                            </a>
                        <% } else { %>
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                <i class="bi bi-funnel me-1"></i> Terapkan
                            </button>
                        <% } %>
                    </div>
                </form>
            </div>
        </div>

        <!-- 4 KPI Stat Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Total Omset</span>
                            <span class="badge bg-success-subtle text-success p-2 rounded-circle">
                                <i class="bi bi-cash-stack fs-5"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold mb-1 text-dark"><%= reportData.summary.totalRevenueFormatted %></h4>
                        <div class="text-muted small">
                            <%= reportData.filters.month ? 'Periode ' + reportData.filters.month : 'Akumulasi Keseluruhan' %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Voucher Terjual</span>
                            <span class="badge bg-primary-subtle text-primary p-2 rounded-circle">
                                <i class="bi bi-ticket-perforated-fill fs-5"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold mb-1 text-dark"><%= (reportData.summary.totalVouchers || 0).toLocaleString('id-ID') %> <span class="fs-6 fw-normal text-muted">lembar</span></h4>
                        <div class="text-muted small">
                            Dari <strong><%= reportData.summary.totalProfiles %> Profil</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Rata-rata Harian</span>
                            <span class="badge bg-info-subtle text-info p-2 rounded-circle">
                                <i class="bi bi-graph-up-arrow fs-5"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold mb-1 text-dark"><%= reportData.summary.avgDailyRevenueFormatted %></h4>
                        <div class="text-muted small">
                            Dari <strong><%= reportData.summary.activeDays %> hari aktif</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase">Rentang Penjualan</span>
                            <span class="badge bg-warning-subtle text-warning p-2 rounded-circle">
                                <i class="bi bi-calendar-range fs-5"></i>
                            </span>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">
                            <%= reportData.summary.firstSale && reportData.summary.lastSale ? reportData.summary.firstSale + ' s/d ' + reportData.summary.lastSale : '-' %>
                        </h6>
                        <div class="text-muted small">
                            Total Profil: <strong><%= reportData.availableProfiles.length %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Two Column Breakdown -->
        <div class="row g-4 mb-4">
            <!-- Left: Akumulasi Per Profil -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-pie-chart-fill text-warning fs-5"></i>
                            <h5 class="fw-bold mb-0 text-dark">Akumulasi Per Profil</h5>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill"><%= reportData.profileBreakdown.length %> Profil</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-uppercase small text-muted">
                                    <th>Profil Voucher</th>
                                    <th class="text-center">Terjual</th>
                                    <th class="text-end">Total Omset</th>
                                    <th class="text-center">Kontribusi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (reportData.profileBreakdown && reportData.profileBreakdown.length > 0) { %>
                                    <% reportData.profileBreakdown.forEach(function(item) { %>
                                        <tr>
                                            <td>
                                                <a href="/routers/<%= router.id %>?tab=reports&profile=<%= encodeURIComponent(item.profile) %>" class="fw-bold text-decoration-none text-dark d-block">
                                                    <%= item.profile %>
                                                </a>
                                                <span class="text-muted" style="font-size: 0.75rem;">Rata-rata: <%= item.avgPriceFormatted %></span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1"><%= item.totalVouchers.toLocaleString('id-ID') %></span>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                <%= item.totalRevenueFormatted %>
                                            </td>
                                            <td class="text-center" style="min-width: 120px;">
                                                <div class="d-flex align-items-center justify-content-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= item.percentage %>%"></div>
                                                    </div>
                                                    <span class="small fw-semibold text-muted" style="font-size: 0.75rem; min-width: 35px;"><%= item.percentage %>%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Tidak ada data profil.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right: Akumulasi Per Bulan & Per Tanggal -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-2 px-3">
                        <ul class="nav nav-pills card-header-pills" id="breakdownPillsTab" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active py-1.5 px-3 small fw-semibold" id="tab-month-tab-btn" data-bs-toggle="pill" data-bs-target="#tab-month-tab" type="button">
                                    <i class="bi bi-calendar3 me-1"></i> Per Bulan
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link py-1.5 px-3 small fw-semibold" id="tab-daily-tab-btn" data-bs-toggle="pill" data-bs-target="#tab-daily-tab" type="button">
                                    <i class="bi bi-calendar-date me-1"></i> Per Tanggal
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body p-0">
                        <div class="tab-content" id="breakdownPillsContent">
                            <div class="tab-pane fade show active" id="tab-month-tab" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr class="text-uppercase small text-muted">
                                                <th>Bulan</th>
                                                <th class="text-center">Hari Aktif</th>
                                                <th class="text-center">Terjual</th>
                                                <th class="text-end">Total Omset</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (reportData.monthlyBreakdown && reportData.monthlyBreakdown.length > 0) { %>
                                                <% reportData.monthlyBreakdown.forEach(function(m) { %>
                                                    <tr>
                                                        <td>
                                                            <a href="/routers/<%= router.id %>?tab=reports&month=<%= m.saleMonth %>" class="fw-bold text-decoration-none text-primary">
                                                                <%= m.monthName %>
                                                            </a>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-muted border"><%= m.activeDays %> hari</span>
                                                        </td>
                                                        <td class="text-center fw-semibold">
                                                            <%= m.totalVouchers.toLocaleString('id-ID') %>
                                                        </td>
                                                        <td class="text-end fw-bold text-success">
                                                            <%= m.totalRevenueFormatted %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="text-center py-4 text-muted">Belum ada data bulanan.</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab-daily-tab" role="tabpanel">
                                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr class="text-uppercase small text-muted">
                                                <th>Tanggal</th>
                                                <th class="text-center">Terjual</th>
                                                <th class="text-end">Omset Harian</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (reportData.dailyBreakdown && reportData.dailyBreakdown.length > 0) { %>
                                                <% reportData.dailyBreakdown.forEach(function(d) { %>
                                                    <tr>
                                                        <td class="fw-semibold">
                                                            <i class="bi bi-calendar-event text-secondary me-1"></i> <%= d.saleDate %>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark border px-2 py-1"><%= d.totalVouchers.toLocaleString('id-ID') %></span>
                                                        </td>
                                                        <td class="text-end fw-bold text-success">
                                                            <%= d.totalRevenueFormatted %>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="3" class="text-center py-4 text-muted">Belum ada data harian.</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Transaksi Voucher Section -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-list-check text-info fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Rincian Transaksi Voucher Hotspot</h5>
                </div>
                <span class="badge bg-secondary-subtle text-dark px-2.5 py-1">Total <%= (reportData.totalTransactions || 0).toLocaleString('id-ID') %> Voucher Terdata</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                    <thead class="table-light">
                        <tr class="text-uppercase small text-muted">
                            <th style="width: 50px;">No</th>
                            <th>Waktu Transaksi</th>
                            <th>Kode Voucher / User</th>
                            <th>Profil</th>
                            <th class="text-end">Harga</th>
                            <th>Masa Aktif</th>
                            <th>IP & MAC Address</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reportData.transactions && reportData.transactions.length > 0) { %>
                            <% reportData.transactions.forEach(function(t, idx) { %>
                                <tr>
                                    <td class="text-muted"><%= ((reportData.currentPage - 1) * 15) + idx + 1 %></td>
                                    <td>
                                        <div class="fw-semibold text-dark"><%= t.sale_date %></div>
                                        <span class="text-muted" style="font-size: 0.75rem;"><%= t.sale_time %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace px-2 py-1 fs-6">
                                            <%= t.voucher_code %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">
                                            <%= t.profile %>
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        <%= t.priceFormatted %>
                                    </td>
                                    <td>
                                        <span class="text-muted"><i class="bi bi-clock me-1"></i><%= t.validity || '-' %></span>
                                    </td>
                                    <td>
                                        <div class="font-monospace text-dark" style="font-size: 0.8rem;"><%= t.ip_address || '-' %></div>
                                        <div class="font-monospace text-muted" style="font-size: 0.75rem;"><%= t.mac_address || '-' %></div>
                                    </td>
                                    <td class="text-truncate text-muted" style="max-width: 180px;" title="<%= t.comment || '' %>">
                                        <%= t.comment || '-' %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                    Tidak ada transaksi voucher yang sesuai dengan kriteria filter.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (reportData.totalPages > 1) { %>
                <div class="card-footer bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="text-muted small">
                        Halaman <strong><%= reportData.currentPage %></strong> dari <strong><%= reportData.totalPages %></strong> (<%= reportData.totalTransactions.toLocaleString('id-ID') %> voucher)
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= reportData.currentPage <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="/routers/<%= router.id %>?tab=reports&month=<%= reportData.filters.month %>&profile=<%= encodeURIComponent(reportData.filters.profile) %>&report_search=<%= encodeURIComponent(reportData.filters.search) %>&report_page=<%= reportData.currentPage - 1 %>">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <% 
                                const startP = Math.max(1, reportData.currentPage - 2);
                                const endP = Math.min(reportData.totalPages, reportData.currentPage + 2);
                                for (let p = startP; p <= endP; p++) { 
                            %>
                                <li class="page-item <%= p === reportData.currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="/routers/<%= router.id %>?tab=reports&month=<%= reportData.filters.month %>&profile=<%= encodeURIComponent(reportData.filters.profile) %>&report_search=<%= encodeURIComponent(reportData.filters.search) %>&report_page=<%= p %>">
                                        <%= p %>
                                    </a>
                                </li>
                            <% } %>
                            <li class="page-item <%= reportData.currentPage >= reportData.totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/routers/<%= router.id %>?tab=reports&month=<%= reportData.filters.month %>&profile=<%= encodeURIComponent(reportData.filters.profile) %>&report_search=<%= encodeURIComponent(reportData.filters.search) %>&report_page=<%= reportData.currentPage + 1 %>">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            <% } %>
        </div>

    <% } else { %>
        <!-- RIWAYAT BACKUP TAB (DEFAULT) -->
        <div class="card shadow-sm border-0 mb-4">
            <% 
                const currentSort = typeof sort !== 'undefined' ? sort : 'time';
                const currentOrder = typeof order !== 'undefined' ? order : 'desc';
                const searchParam = typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '';
            %>
            <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold text-dark">Berkas Backup Tersimpan</span>
                    <span class="text-muted small">&bull; <%= totalBackups %> file (<%= totalSizeFormatted %>)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <form method="GET" action="/routers/<%= router.id %>" class="d-flex align-items-center gap-1">
                        <input type="hidden" name="tab" value="backups">
                        <input type="hidden" name="sort" value="<%= currentSort %>">
                        <input type="hidden" name="order" value="<%= currentOrder %>">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control form-control-sm border-start-0" placeholder="Cari berkas..." value="<%= typeof search !== 'undefined' ? search : '' %>">
                            <% if (typeof search !== 'undefined' && search) { %>
                                <a href="/routers/<%= router.id %>?tab=backups&sort=<%= currentSort %>&order=<%= currentOrder %>" class="btn btn-outline-secondary btn-sm" title="Hapus pencarian">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            <% } %>
                            <button type="submit" class="btn btn-primary btn-sm px-2.5">Cari</button>
                        </div>
                    </form>
                    <button type="button" class="btn btn-sm btn-primary text-white d-inline-flex align-items-center gap-1 shadow-sm rounded-2" data-bs-toggle="modal" data-bs-target="#uploadManualBackupModal">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>Upload Manual</span>
                    </button>
                    <a href="/routers/<%= router.id %>?tab=script" class="btn btn-sm btn-light border text-secondary">
                        <i class="bi bi-terminal me-1 text-primary"></i> Setup Script
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4 py-3">
                                <a href="/routers/<%= router.id %>?tab=backups&sort=name&order=<%= currentSort === 'name' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= searchParam %>" 
                                   class="text-decoration-none <%= currentSort === 'name' ? 'fw-bold text-primary' : 'text-secondary' %> d-inline-flex align-items-center gap-1.5" 
                                   title="Urutkan berdasarkan Nama Berkas">
                                    <span>Nama Berkas</span>
                                    <% if (currentSort === 'name') { %>
                                        <i class="bi bi-sort-alpha-<%= currentOrder === 'asc' ? 'down' : 'up' %> fs-6"></i>
                                    <% } else { %>
                                        <i class="bi bi-arrow-down-up opacity-25"></i>
                                    <% } %>
                                </a>
                            </th>
                            <th class="py-3">
                                <a href="/routers/<%= router.id %>?tab=backups&sort=type&order=<%= currentSort === 'type' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= searchParam %>" 
                                   class="text-decoration-none <%= currentSort === 'type' ? 'fw-bold text-primary' : 'text-secondary' %> d-inline-flex align-items-center gap-1.5" 
                                   title="Urutkan berdasarkan Tipe File">
                                    <span>Tipe</span>
                                    <% if (currentSort === 'type') { %>
                                        <i class="bi bi-sort-<%= currentOrder === 'asc' ? 'down' : 'up' %> fs-6"></i>
                                    <% } else { %>
                                        <i class="bi bi-arrow-down-up opacity-25"></i>
                                    <% } %>
                                </a>
                            </th>
                            <th class="py-3 text-secondary">Ukuran</th>
                            <th class="py-3">
                                <a href="/routers/<%= router.id %>?tab=backups&sort=time&order=<%= currentSort === 'time' && currentOrder === 'asc' ? 'desc' : 'asc' %><%= searchParam %>" 
                                   class="text-decoration-none <%= currentSort === 'time' ? 'fw-bold text-primary' : 'text-secondary' %> d-inline-flex align-items-center gap-1.5" 
                                   title="Urutkan berdasarkan Waktu Backup">
                                    <span>Waktu Backup</span>
                                    <% if (currentSort === 'time') { %>
                                        <i class="bi bi-sort-numeric-<%= currentOrder === 'asc' ? 'down' : 'down-alt' %> fs-6"></i>
                                    <% } else { %>
                                        <i class="bi bi-arrow-down-up opacity-25"></i>
                                    <% } %>
                                </a>
                            </th>
                            <th class="text-end pe-4 py-3 text-secondary">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (backups.length > 0) { %>
                            <% backups.forEach(function(b) { %>
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi <%= b.file_type === 'rsc' ? 'bi-file-earmark-code text-info' : 'bi-file-earmark-binary text-primary' %> fs-5"></i>
                                            <span class="fw-medium text-dark font-monospace"><%= b.file_path ? b.file_path.split('/').pop() : 'backup' %></span>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge <%= b.file_type === 'rsc' ? 'bg-info-subtle text-info border border-info-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> text-uppercase fw-semibold" style="font-size: 0.7rem;">
                                            .<%= b.file_type %>
                                        </span>
                                    </td>
                                    <td class="py-3 text-secondary small font-monospace">
                                        <%= formatBytes(b.file_size) %>
                                    </td>
                                    <td class="py-3 text-muted small">
                                        <span class="text-dark fw-medium"><%= formatDate(b.created_at) %> WIB</span>
                                        <div class="text-muted" style="font-size: 0.75rem;"><%= diffForHumans(b.created_at) %></div>
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                            <% if (b.file_type === 'rsc') { %>
                                                <a href="/backup/preview/<%= b.id %>" class="btn btn-sm btn-info text-white rounded-2 py-1 px-2.5 d-inline-flex align-items-center gap-1 shadow-sm" onclick="openRscPreview(<%= b.id %>); return false;" title="Lihat Isi Script (.rsc)">
                                                    <i class="bi bi-file-earmark-code"></i> <span>Lihat Isi</span>
                                                </a>
                                            <% } %>
                                            <a href="/backup/download/<%= b.id %>" class="btn btn-sm btn-outline-primary rounded-2 py-1 px-2.5" title="Unduh File">
                                                <i class="bi bi-download me-1"></i> Unduh
                                            </a>
                                            <form action="/backup/<%= b.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Hapus file backup ini secara permanen?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-2 py-1 px-2" title="Hapus">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted small">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    <% if (typeof search !== 'undefined' && search) { %>
                                        <p class="mb-2">Tidak ditemukan berkas backup dengan kata kunci <strong>"<%= search %>"</strong>.</p>
                                        <a href="/routers/<%= router.id %>?tab=backups" class="btn btn-sm btn-outline-secondary">Reset Pencarian</a>
                                    <% } else { %>
                                        <p class="mb-3">Belum ada berkas backup yang tersimpan untuk router ini.</p>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadManualBackupModal">
                                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Backup Manual
                                            </button>
                                            <a href="/routers/<%= router.id %>?tab=script" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-terminal me-1"></i> Setup Script Backup
                                            </a>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %></small>
                    <ul class="pagination pagination-sm mb-0">
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="/routers/<%= router.id %>?tab=backups&sort=<%= currentSort %>&order=<%= currentOrder %>&page=<%= p %><%= searchParam %>"><%= p %></a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

<!-- Delete Router Confirmation Modal -->
<div class="modal fade" id="deleteRouterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Konfirmasi Hapus Router</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Hapus router <strong><%= router.name %></strong> beserta seluruh riwayat backup-nya?</p>
                <div class="alert alert-danger small mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Tindakan ini tidak dapat dibatalkan.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Batal</button>
                <form action="/routers/<%= router.id %>?_method=DELETE" method="POST">
                    <button type="submit" class="btn btn-sm btn-danger">Ya, Hapus Permanen</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Upload Manual Backup Modal (Feature 3) -->
<div class="modal fade" id="uploadManualBackupModal" tabindex="-1" aria-labelledby="uploadManualBackupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="uploadManualBackupModalLabel">
                    <i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i>Upload Berkas Backup Manual
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/routers/<%= router.id %>/manual-upload" method="POST" enctype="multipart/form-data" id="manualUploadForm">
                <div class="modal-body p-4">
                    <!-- Penjelasan Langkah 1: Pembuatan File di MikroTik -->
                    <div class="alert alert-primary-subtle border border-primary-subtle rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-primary mb-2 d-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                            <i class="bi bi-terminal-fill"></i> Langkah 1: Buat & Ambil Berkas dari MikroTik
                        </h6>
                        <ol class="small text-dark mb-0 ps-3" style="line-height: 1.6;">
                            <li>Buka <strong>Winbox</strong> atau terminal SSH router <strong><%= router.name %></strong>.</li>
                            <li>Jalankan salah satu perintah berikut di terminal MikroTik:
                                <div class="bg-dark text-light p-2.5 rounded font-monospace small my-2">
                                    <div class="text-info mb-1 fw-bold"># Opsi A: Backup Biner Sistem Lengkap (.backup)</div>
                                    <code class="text-white">/system backup save name="<%= router.name.toLowerCase().replace(/[^a-z0-9_-]/g, '-') %>-manual"</code>
                                    <div class="text-warning mt-2 mb-1 fw-bold"># Opsi B: Export Script Konfigurasi (.rsc)</div>
                                    <code class="text-white">/export show-sensitive file="<%= router.name.toLowerCase().replace(/[^a-z0-9_-]/g, '-') %>-manual"</code>
                                </div>
                            </li>
                            <li>Buka menu <strong>Files</strong> di Winbox, lalu seret (<em>drag-and-drop</em>) berkas tersebut ke komputer Anda.</li>
                        </ol>
                    </div>

                    <!-- Penjelasan Langkah 2: Format & Standar Penamaan -->
                    <div class="card border border-light-subtle bg-light rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                            <i class="bi bi-info-circle-fill text-info"></i> Langkah 2: Format & Standar Penamaan Berkas
                        </h6>
                        <ul class="small text-muted mb-0 ps-3" style="line-height: 1.6;">
                            <li><strong>Ekstensi Berkas Wajib:</strong> Hanya berkas berakhiran <code>.backup</code> (binary) atau <code>.rsc</code> (script teks) yang diterima.</li>
                            <li><strong>Rekomendasi Format Nama:</strong> <code>[NamaRouter]_[Tanggal].[backup|rsc]</code>
                                <br><span class="text-dark fw-semibold">Contoh:</span> <code><%= router.name.toLowerCase().replace(/[^a-z0-9_-]/g, '-') %>_2026-10-26.backup</code> atau <code><%= router.name.toLowerCase().replace(/[^a-z0-9_-]/g, '-') %>_2026-10-26.rsc</code>
                            </li>
                            <li><strong>Hindari Karakter Khusus:</strong> Jangan gunakan spasi, tanda tanya, atau simbol (<code>!@#$%^&*()</code>) agar berkas aman saat di-restore kembali ke MikroTik.</li>
                            <li><strong>Ukuran Maksimal:</strong> Hingga <strong>100 MB</strong> per berkas.</li>
                        </ul>
                    </div>

                    <!-- Penjelasan Langkah 3: Formulir Upload -->
                    <div class="mb-3">
                        <label for="manualBackupFile" class="form-label fw-bold small text-dark">
                            Langkah 3: Pilih Berkas dari Komputer Anda
                        </label>
                        <input type="file" 
                               class="form-control" 
                               id="manualBackupFile" 
                               name="backup_file" 
                               accept=".backup,.rsc" 
                               required 
                               onchange="validateSelectedFile(this)">
                        <div class="form-text small" id="fileValidationText">
                            Pilih file berekstensi <code>.backup</code> atau <code>.rsc</code> dari penyimpanan lokal Anda.
                        </div>
                    </div>

                    <!-- Preview box of selected file -->
                    <div id="fileInfoBox" class="p-3 bg-white border rounded-2 d-none">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check text-success fs-4" id="fileTypeIcon"></i>
                                <div>
                                    <div class="fw-bold text-dark small" id="fileNamePreview">-</div>
                                    <div class="text-muted small" id="fileSizePreview" style="font-size: 0.72rem;">-</div>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle" id="fileBadgePreview">Valid</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-2" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary rounded-2 px-3" id="btnSubmitManualUpload">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload & Simpan ke Cloud
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function copyScriptToClipboard() {
        const text = document.getElementById('scriptPreContent').innerText;
        navigator.clipboard.writeText(text).then(() => {
            const btn = document.getElementById('copyScriptBtn');
            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> <span class="text-success">Tersalin!</span>';
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-clipboard"></i> <span>Salin Script</span>';
            }, 2000);
        });
    }

    function toggleTokenVisibility() {
        const input = document.getElementById('apiTokenInput');
        const icon = document.getElementById('tokenEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    function validateSelectedFile(input) {
        const file = input.files[0];
        const infoBox = document.getElementById('fileInfoBox');
        const namePreview = document.getElementById('fileNamePreview');
        const sizePreview = document.getElementById('fileSizePreview');
        const badgePreview = document.getElementById('fileBadgePreview');
        const icon = document.getElementById('fileTypeIcon');

        if (!file) {
            infoBox.classList.add('d-none');
            return;
        }

        const name = file.name.toLowerCase();
        const isBackup = name.endsWith('.backup');
        const isRsc = name.endsWith('.rsc');

        if (!isBackup && !isRsc) {
            alert('Format file tidak didukung! Harap pilih file berekstensi .backup atau .rsc.');
            input.value = '';
            infoBox.classList.add('d-none');
            return;
        }

        infoBox.classList.remove('d-none');
        namePreview.textContent = file.name;
        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
        sizePreview.textContent = `${sizeMb} MB (${file.size.toLocaleString('id-ID')} bytes)`;
        badgePreview.textContent = isBackup ? 'Binary Backup (.backup)' : 'Configuration Script (.rsc)';
        badgePreview.className = isBackup ? 'badge bg-primary-subtle text-primary border border-primary-subtle' : 'badge bg-info-subtle text-info border border-info-subtle';
        icon.className = isBackup ? 'bi bi-file-earmark-binary text-primary fs-4' : 'bi bi-file-earmark-code text-info fs-4';
    }

    document.getElementById('manualUploadForm')?.addEventListener('submit', function() {
        const btn = document.getElementById('btnSubmitManualUpload');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Mengunggah & Memproses...';
    });
</script>