<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Profil & Keamanan Akun</h3>
        <p class="text-muted small mb-0">Kelola informasi identitas Anda, ganti kata sandi mandiri, dan pantau riwayat pembaruan akun</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-arrow-left"></i>
            <span>Kembali ke Dashboard</span>
        </a>
    </div>
</div>

<!-- Timestamp Alert Card (Feature 1 Requirement) -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary-subtle text-primary-emphasis border-start border-primary border-4">
    <div class="card-body p-3.5 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-white text-primary p-2.5 shadow-xs d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-clock-history fs-5"></i>
            </div>
            <div>
                <div class="text-uppercase small fw-bold text-primary" style="font-size: 0.72rem; letter-spacing: 0.5px;">Informasi Waktu & Keamanan</div>
                <div class="fw-bold text-dark fs-6">
                    Terakhir Diperbarui: 
                    <span class="text-primary font-monospace"><%= formatDate(user.updated_at, 'DD MMMM YYYY, HH:mm:ss') %> WIB</span>
                    <span class="text-muted fw-normal small">(<%= diffForHumans(user.updated_at) %>)</span>
                </div>
                <small class="text-muted" style="font-size: 0.75rem;">
                    Akun terdaftar sejak: <strong><%= formatDate(user.created_at, 'DD MMMM YYYY, HH:mm') %> WIB</strong> (<%= diffForHumans(user.created_at) %>)
                </small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill">
                <i class="bi bi-shield-check me-1"></i> Akun Terlindungi
            </span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Kolom Kiri: Ringkasan Akun & Statistik -->
    <div class="col-lg-4">
        <!-- Kartu Identitas Akun -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-4 text-center">
                <div class="position-relative d-inline-block mb-3">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 80px; height: 80px;">
                        <i class="bi <%= user.role === 'admin' ? 'bi-shield-shaded' : 'bi-person-circle' %> fs-1"></i>
                    </div>
                    <span class="position-absolute bottom-0 end-0 p-1.5 bg-success border border-white rounded-circle" title="Status Akun Aktif"></span>
                </div>
                <h5 class="fw-bold text-dark mb-1"><%= user.name %></h5>
                <p class="text-muted small mb-2"><%= user.email %></p>
                <div class="d-flex justify-content-center gap-1.5 mb-3">
                    <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-primary' %> text-uppercase px-2.5 py-1" style="font-size: 0.7rem;">
                        <%= user.role === 'admin' ? 'Administrator' : 'Tenant User' %>
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size: 0.7rem;">
                        <i class="bi bi-check-circle-fill me-0.5"></i> Aktif
                    </span>
                </div>

                <hr class="border-light my-3">

                <!-- 3 Mini Stats -->
                <div class="row text-center g-2">
                    <div class="col-4 border-end">
                        <div class="fw-bold text-dark fs-6"><%= stats.totalRouters %></div>
                        <div class="text-muted" style="font-size: 0.7rem;">Router</div>
                    </div>
                    <div class="col-4 border-end">
                        <div class="fw-bold text-dark fs-6"><%= stats.totalBackups %></div>
                        <div class="text-muted" style="font-size: 0.7rem;">Berkas</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-dark fs-6"><%= formatBytes(stats.totalSize) %></div>
                        <div class="text-muted" style="font-size: 0.7rem;">Storage</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kartu Catatan Keamanan -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 px-4 border-bottom border-light">
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock text-primary"></i>
                    <span>Catatan Keamanan</span>
                </h6>
            </div>
            <div class="card-body p-4 text-muted small">
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2.5">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-0.5"></i>
                        <span>Kata sandi dienkripsi dengan standar <strong>bcrypt hash</strong> berkekuatan tinggi.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-0.5"></i>
                        <span>Setiap perubahan data dan kata sandi dicatat dalam audit log sistem.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-0.5"></i>
                        <span>Gunakan kata sandi unik minimal 8 karakter dengan kombinasi angka dan simbol.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Kolom Kanan: Form Edit Profil & Ganti Password -->
    <div class="col-lg-8">
        <!-- Form 1: Ubah Informasi Profil -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom border-light d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-person text-primary"></i>
                    <span>Informasi Profil</span>
                </h5>
                <span class="badge bg-light text-muted border small font-monospace">
                    ID: <%= user.id %>
                </span>
            </div>
            <div class="card-body p-4">
                <form action="/profile" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label fw-bold small text-dark">Nama Lengkap</label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required>
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label fw-bold small text-dark">Alamat Email</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Role Akses</label>
                            <input type="text" class="form-control bg-light" value="<%= user.role === 'admin' ? 'Administrator Sistem' : 'Tenant / Pengguna Biasa' %>" readonly disabled>
                            <div class="form-text small" style="font-size: 0.72rem;">Hak akses role hanya dapat diubah oleh Administrator Utama.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Waktu Terakhir Disimpan</label>
                            <input type="text" class="form-control bg-light font-monospace" value="<%= formatDate(user.updated_at, 'DD/MM/YYYY HH:mm:ss') %> WIB" readonly disabled>
                            <div class="form-text small" style="font-size: 0.72rem;">Otomatis diperbarui saat ada modifikasi data akun.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-2 border-top border-light">
                        <button type="submit" class="btn btn-primary px-4 rounded-2 shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-lg"></i>
                            <span>Simpan Perubahan Profil</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Form 2: Ganti Kata Sandi Mandiri -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom border-light">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-key text-warning"></i>
                    <span>Ganti Kata Sandi</span>
                </h5>
            </div>
            <div class="card-body p-4">
                <form action="/profile/password" method="POST" autocomplete="off">
                    <!-- Dummy inputs for aggressive autofill prevention -->
                    <input type="text" style="display:none;" tabindex="-1">
                    <input type="password" style="display:none;" tabindex="-1">

                    <div class="mb-3">
                        <label for="current_password" class="form-label fw-bold small text-dark">Kata Sandi Saat Ini</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="current_password" name="current_password" placeholder="Masukkan kata sandi lama Anda" required autocomplete="current-password">
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('current_password', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="new_password" class="form-label fw-bold small text-dark">Kata Sandi Baru (Min. 8 Karakter)</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="new_password" name="new_password" minlength="8" placeholder="Minimal 8 karakter baru" required autocomplete="new-password">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('new_password', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="confirm_password" class="form-label fw-bold small text-dark">Konfirmasi Kata Sandi Baru</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirm_password" name="confirm_password" minlength="8" placeholder="Ulangi kata sandi baru" required autocomplete="new-password">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('confirm_password', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-2 border-top border-light">
                        <button type="submit" class="btn btn-warning text-dark fw-semibold px-4 rounded-2 shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock"></i>
                            <span>Perbarui Kata Sandi</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Riwayat Aktivitas Mandiri -->
        <% if (recentLogs && recentLogs.length > 0) { %>
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-journal-text text-info"></i>
                        <span>Riwayat Aktivitas Akun Anda</span>
                    </h6>
                    <small class="text-muted"><%= recentLogs.length %> aktivitas terakhir</small>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                            <tr>
                                <th class="ps-4 py-2.5">Aksi / Tindakan</th>
                                <th class="py-2.5">Waktu Eksekusi</th>
                                <th class="py-2.5 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentLogs.forEach(function(log) { %>
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="fw-semibold text-dark"><%= log.action %></div>
                                        <div class="text-muted small" style="font-size: 0.75rem;"><%= log.description %></div>
                                    </td>
                                    <td class="py-2.5 text-muted small">
                                        <div><%= formatDate(log.created_at, 'DD/MM/YYYY HH:mm') %> WIB</div>
                                        <small style="font-size: 0.72rem;"><%= diffForHumans(log.created_at) %></small>
                                    </td>
                                    <td class="py-2.5 text-center">
                                        <span class="badge <%= log.status === 'success' ? 'bg-success-subtle text-success border border-success-subtle' : (log.status === 'warning' ? 'bg-warning-subtle text-warning border border-warning-subtle' : 'bg-info-subtle text-info border border-info-subtle') %> rounded-pill px-2.5 py-1" style="font-size: 0.7rem;">
                                            <%= log.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (!input || !icon) return;

    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}
</script>
