<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Monitoring' %> - <%= appName %></title>

    <!-- Browser Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon-MikBack.svg">
    <link rel="alternate icon" type="image/png" href="/Logo-MikBack.png">

    <!-- Google Font & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        (function() {
            if (localStorage.getItem('sidebar_collapsed') === 'true') {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 72px;
            --sidebar-bg: #0f172a;
            --sidebar-border: rgba(255, 255, 255, 0.08);
            --sidebar-color: #94a3b8;
            --sidebar-hover-bg: rgba(255, 255, 255, 0.06);
            --sidebar-active-bg: #0284c7;
            --sidebar-active-color: #ffffff;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
        }

        .shrink-0 { flex-shrink: 0 !important; }
        .grow { flex-grow: 1 !important; }

        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-color);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1030;
            display: flex;
            flex-direction: column;
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), transform 0.25s ease-in-out;
            overflow: visible;
        }

        .sidebar-brand {
            height: 64px;
            padding: 0 1.25rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--sidebar-border);
            white-space: nowrap;
            overflow: hidden;
        }

        .sidebar-brand-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: #ffffff;
            width: 100%;
            overflow: hidden;
        }

        .sidebar-brand-link:hover { color: #ffffff; }

        .sidebar-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
            transition: opacity 0.2s ease;
        }

        .sidebar-menu {
            padding: 1rem 0;
            flex-grow: 1;
            overflow-y: auto;
            overflow-x: visible;
        }

        .sidebar-heading {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            font-weight: 700;
            padding: 0.75rem 1.25rem 0.35rem;
            white-space: nowrap;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.65rem 1.25rem;
            color: var(--sidebar-color);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.88rem;
            transition: all 0.15s ease-in-out;
            border-left: 3px solid transparent;
            position: relative;
            white-space: nowrap;
        }

        .nav-link-custom:hover {
            color: #f8fafc;
            background-color: var(--sidebar-hover-bg);
        }

        .nav-link-custom.active {
            color: #38bdf8;
            background-color: rgba(56, 189, 248, 0.1);
            border-left-color: #38bdf8;
            font-weight: 600;
        }

        .nav-link-custom i {
            font-size: 1.15rem;
            min-width: 1.5rem;
            text-align: center;
            display: inline-flex;
            justify-content: center;
            align-items: center;
        }

        .sidebar-footer {
            height: 64px;
            padding: 0 1rem;
            border-top: 1px solid var(--sidebar-border);
            background-color: rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            justify-content: space-between;
            overflow: hidden;
        }

        .main-wrapper {
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .top-navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 1.5rem;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 1020;
        }

        html.sidebar-collapsed .sidebar,
        body.sidebar-collapsed .sidebar {
            width: var(--sidebar-collapsed-width);
            overflow: visible !important;
        }

        html.sidebar-collapsed .main-wrapper,
        body.sidebar-collapsed .main-wrapper {
            margin-left: var(--sidebar-collapsed-width);
        }

        html.sidebar-collapsed .sidebar-menu,
        body.sidebar-collapsed .sidebar-menu {
            overflow: visible !important;
        }

        html.sidebar-collapsed .sidebar-brand-text,
        body.sidebar-collapsed .sidebar-brand-text {
            display: none !important;
        }

        html.sidebar-collapsed .sidebar-brand,
        body.sidebar-collapsed .sidebar-brand {
            padding: 0 !important;
            justify-content: center !important;
        }

        html.sidebar-collapsed .sidebar-brand-link,
        body.sidebar-collapsed .sidebar-brand-link {
            justify-content: center !important;
            width: auto !important;
            padding: 0 !important;
        }

        html.sidebar-collapsed .sidebar-heading,
        body.sidebar-collapsed .sidebar-heading {
            height: 1px;
            margin: 0.6rem 0.75rem;
            padding: 0;
            font-size: 0;
            background: rgba(255, 255, 255, 0.08);
            border: none;
            overflow: hidden;
        }

        html.sidebar-collapsed .nav-link-custom,
        body.sidebar-collapsed .nav-link-custom {
            padding: 0.75rem 0;
            margin: 0.25rem 0.5rem;
            justify-content: center;
            border-left: none;
            border-radius: 0.5rem;
            position: relative;
        }

        html.sidebar-collapsed .nav-link-custom .nav-text,
        body.sidebar-collapsed .nav-link-custom .nav-text {
            display: none !important;
        }

        html.sidebar-collapsed .nav-link-custom.active,
        body.sidebar-collapsed .nav-link-custom.active {
            background-color: #0284c7;
            color: #ffffff;
        }

        html.sidebar-collapsed .sidebar-footer,
        body.sidebar-collapsed .sidebar-footer {
            padding: 0;
            justify-content: center;
            overflow: hidden;
        }

        html.sidebar-collapsed .sidebar-footer .d-flex,
        body.sidebar-collapsed .sidebar-footer .d-flex {
            justify-content: center !important;
            width: auto !important;
        }

        html.sidebar-collapsed .sidebar-user-details,
        body.sidebar-collapsed .sidebar-user-details {
            display: none !important;
        }

        html.sidebar-collapsed .nav-link-custom::after,
        body.sidebar-collapsed .nav-link-custom::after {
            content: attr(data-menu-title);
            position: absolute;
            left: 100%;
            top: 50%;
            transform: translateY(-50%) translateX(6px);
            background-color: #0f172a;
            color: #ffffff;
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.01em;
            padding: 0.45rem 0.8rem;
            border-radius: 0.4rem;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
            z-index: 99999;
            transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
        }

        html.sidebar-collapsed .nav-link-custom:hover::after,
        body.sidebar-collapsed .nav-link-custom:hover::after {
            opacity: 1;
            visibility: visible;
            transform: translateY(-50%) translateX(12px);
        }

        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.875rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
            background-color: #ffffff;
        }

        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            border-top-left-radius: 0.875rem !important;
            border-top-right-radius: 0.875rem !important;
            padding: 1rem 1.35rem;
        }

        .pulse-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse-green 2s infinite;
        }

        @keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        @media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-wrapper { margin-left: 0 !important; }
            .sidebar-backdrop {
                position: fixed;
                top: 0; left: 0; width: 100vw; height: 100vh;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1025; display: none;
            }
            .sidebar-backdrop.show { display: block; }
        }
    </style>
</head>
<body>

<% if (currentUser) { %>
    <!-- Mobile Sidebar Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarMobile()"></div>

    <!-- Sidebar Navigation -->
    <aside class="sidebar" id="appSidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <a href="/dashboard" class="sidebar-brand-link">
                <img src="/Logo-MikBack.png" alt="MikBack Logo" class="shrink-0 rounded-2" style="width: 38px; height: 38px; object-fit: contain;">
                <div class="sidebar-brand-text">
                    <div class="fw-bold"><span class="text-white">Mik</span><span class="text-primary">Back</span></div>
                    <div style="font-size: 0.65rem; font-weight: normal; color: #94a3b8;">Monitoring System</div>
                </div>
            </a>
        </div>

        <!-- Menu Links -->
        <div class="sidebar-menu">
            <% if (currentUser.role === 'admin') { %>
                <div class="sidebar-heading">Menu Utama</div>
                <a href="/dashboard" class="nav-link-custom <%= currentPath === '/dashboard' ? 'active' : '' %>" data-menu-title="Dashboard Admin">
                    <i class="bi bi-speedometer2"></i>
                    <span class="nav-text">Dashboard Admin</span>
                </a>
                <a href="/routers" class="nav-link-custom <%= currentPath.startsWith('/routers') && currentPath !== '/routers/create' ? 'active' : '' %>" data-menu-title="Semua Router">
                    <i class="bi bi-router-fill"></i>
                    <span class="nav-text">Semua Router</span>
                </a>
                <a href="/routers/create" class="nav-link-custom <%= currentPath === '/routers/create' ? 'active' : '' %>" data-menu-title="Tambah Router">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span class="nav-text">Tambah Router</span>
                </a>
                <a href="/reports" class="nav-link-custom <%= currentPath.startsWith('/reports') ? 'active' : '' %>" data-menu-title="Laporan Voucher">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="nav-text">Laporan Voucher</span>
                </a>

                <div class="sidebar-heading mt-3">Administrasi Sistem</div>
                <a href="/admin/users" class="nav-link-custom <%= currentPath.startsWith('/admin/users') && currentPath !== '/admin/users/create' ? 'active' : '' %>" data-menu-title="Kelola Pengguna">
                    <i class="bi bi-people-fill"></i>
                    <span class="nav-text">Kelola Pengguna</span>
                </a>
                <a href="/admin/users/create" class="nav-link-custom <%= currentPath === '/admin/users/create' ? 'active' : '' %>" data-menu-title="Tambah Pengguna">
                    <i class="bi bi-person-plus-fill"></i>
                    <span class="nav-text">Tambah Pengguna</span>
                </a>
                <a href="/admin/script-templates" class="nav-link-custom <%= currentPath.startsWith('/admin/script-templates') ? 'active' : '' %>" data-menu-title="Template Script">
                    <i class="bi bi-file-earmark-code-fill"></i>
                    <span class="nav-text">Template Script</span>
                </a>
                <a href="/admin/retention" class="nav-link-custom <%= currentPath.startsWith('/admin/retention') ? 'active' : '' %>" data-menu-title="Retensi & Storage">
                    <i class="bi bi-database-fill-gear"></i>
                    <span class="nav-text">Retensi & Storage</span>
                </a>
                <a href="/admin/logs" class="nav-link-custom <%= currentPath.startsWith('/admin/logs') ? 'active' : '' %>" data-menu-title="Audit & Log Sistem">
                    <i class="bi bi-journal-text"></i>
                    <span class="nav-text">Audit & Log Sistem</span>
                </a>
                <a href="/admin/settings" class="nav-link-custom <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>" data-menu-title="Pengaturan Aplikasi">
                    <i class="bi bi-gear-fill"></i>
                    <span class="nav-text">Pengaturan Aplikasi</span>
                </a>
            <% } else { %>
                <div class="sidebar-heading">Tenant Menu</div>
                <a href="/dashboard" class="nav-link-custom <%= currentPath === '/dashboard' ? 'active' : '' %>" data-menu-title="Dashboard Saya">
                    <i class="bi bi-speedometer2"></i>
                    <span class="nav-text">Dashboard Saya</span>
                </a>
                <a href="/routers" class="nav-link-custom <%= currentPath.startsWith('/routers') && currentPath !== '/routers/create' ? 'active' : '' %>" data-menu-title="Router Milik Saya">
                    <i class="bi bi-router-fill"></i>
                    <span class="nav-text">Router Milik Saya</span>
                </a>
                <a href="/routers/create" class="nav-link-custom <%= currentPath === '/routers/create' ? 'active' : '' %>" data-menu-title="Tambah Router Baru">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span class="nav-text">Tambah Router Baru</span>
                </a>
                <a href="/reports" class="nav-link-custom <%= currentPath.startsWith('/reports') ? 'active' : '' %>" data-menu-title="Laporan Voucher">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="nav-text">Laporan Voucher</span>
                </a>
            <% } %>
        </div>

        <!-- Sidebar User Profile Footer -->
        <div class="sidebar-footer">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-2 overflow-hidden sidebar-user-details">
                    <div class="badge bg-secondary-subtle text-white p-2 rounded-circle shrink-0">
                        <i class="bi bi-person-circle fs-5"></i>
                    </div>
                    <div class="text-truncate">
                        <div class="text-white small fw-bold text-truncate"><%= currentUser.name %></div>
                        <span class="badge <%= currentUser.role === 'admin' ? 'bg-danger' : 'bg-primary' %> text-uppercase" style="font-size: 0.65rem;">
                            <%= currentUser.role %>
                        </span>
                    </div>
                </div>
                <form action="/logout" method="POST" class="m-0 shrink-0" title="Keluar (Logout)">
                    <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center p-1.5 rounded-2" style="width: 32px; height: 32px;">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <!-- Impersonation Alert Banner -->
        <% if (impersonatorId) { %>
            <div class="bg-warning text-dark py-2 px-3 border-bottom shadow-sm">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <i class="bi bi-person-fill-exclamation fs-5 me-2 align-middle"></i>
                        <strong>Mode Impersonasi Aktif:</strong> Anda sedang login sebagai 
                        <span class="badge bg-dark text-white"><%= currentUser.name %> (<%= currentUser.email %>)</span>
                    </div>
                    <form action="/impersonate/leave" method="POST" class="m-0">
                        <button type="submit" class="btn btn-sm btn-dark">
                            <i class="bi bi-box-arrow-left me-1"></i> Kembali ke Administrator
                        </button>
                    </form>
                </div>
            </div>
        <% } %>

        <!-- Top Header Bar -->
        <header class="top-navbar d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-light border d-lg-none p-1.5 rounded-2 d-flex align-items-center justify-content-center" type="button" onclick="toggleSidebarMobile()" style="width: 36px; height: 36px;">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <button class="btn btn-light border d-none d-lg-inline-flex align-items-center justify-content-center p-1.5 rounded-2" id="sidebarToggleBtn" type="button" onclick="toggleSidebarCollapse()" style="width: 36px; height: 36px;">
                    <i class="bi bi-layout-sidebar-inset fs-5 text-secondary" id="sidebarToggleIcon"></i>
                </button>
                <div>
                    <h5 class="mb-0 fw-bold"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h5>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-md-inline"><%= currentUser.name %></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header">
                            <small class="text-muted">Akun Aktif</small><br>
                            <strong><%= currentUser.email %></strong>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="/logout" method="POST">
                                <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> Keluar (Logout)
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="p-4 grow">
            <div class="container-fluid p-0">
                <!-- Flash Alerts -->
                <% if (flash.success && flash.success.length) { %>
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> <%= flash.success[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (flash.error && flash.error.length) { %>
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= flash.error[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (flash.info && flash.info.length) { %>
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i> <%= flash.info[0] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <%- body %>
            </div>
        </main>

        <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
            <div class="container-fluid">
                <span>&copy; <%= new Date().getFullYear() %> <strong>MikBack System</strong>.</span>
            </div>
        </footer>
    </div>
<% } else { %>
    <main class="py-5">
        <div class="container">
            <%- body %>
        </div>
    </main>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    function syncSidebarToggleIcon(isCollapsed) {
        const icon = document.getElementById('sidebarToggleIcon');
        const btn = document.getElementById('sidebarToggleBtn');
        if (icon) {
            if (isCollapsed) {
                icon.className = 'bi bi-layout-sidebar fs-5 text-primary';
                if (btn) btn.setAttribute('title', 'Buka Sidebar');
            } else {
                icon.className = 'bi bi-layout-sidebar-inset fs-5 text-secondary';
                if (btn) btn.setAttribute('title', 'Tutup Sidebar');
            }
        }
    }

    function toggleSidebarCollapse() {
        const isCurrentlyCollapsed = document.documentElement.classList.contains('sidebar-collapsed');
        const newState = !isCurrentlyCollapsed;
        document.documentElement.classList.toggle('sidebar-collapsed', newState);
        document.body.classList.toggle('sidebar-collapsed', newState);
        localStorage.setItem('sidebar_collapsed', newState ? 'true' : 'false');
        syncSidebarToggleIcon(newState);
    }

    function toggleSidebarMobile() {
        const sidebar = document.getElementById('appSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        if (sidebar && backdrop) {
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('show');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const savedState = localStorage.getItem('sidebar_collapsed') === 'true';
        document.documentElement.classList.toggle('sidebar-collapsed', savedState);
        if (document.body) document.body.classList.toggle('sidebar-collapsed', savedState);
        syncSidebarToggleIcon(savedState);
    });
</script>
<%- include('components/rsc-preview-modal') %>
</body>
</html>