<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0 text-dark">Template Script MikroTik</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                <%= templates.length %> Template
            </span>
        </div>
        <p class="text-muted small mb-0">
            Kelola dan kustomisasi template script RouterOS yang di-generate secara otomatis untuk seluruh router.
        </p>
    </div>
</div>

<!-- Placeholders Info -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-info-circle-fill text-primary"></i>
            <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.04em;">Variabel Dinamis (Placeholders)</span>
        </div>
        <p class="text-muted small mb-3">
            Variabel di bawah ini akan digantikan secara otomatis dengan nilai konfigurasi spesifik milik masing-masing router saat pengguna menyalin script:
        </p>
        <div class="row g-2">
            <div class="col-sm-6 col-lg-3">
                <div class="p-2.5 bg-white border rounded-2">
                    <code class="fw-bold text-primary">{{TOKEN}}</code>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">Token API autentikasi router (32 karakter)</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-2.5 bg-white border rounded-2">
                    <code class="fw-bold text-primary">{{URL}}</code>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">URL endpoint API upload web monitoring</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-2.5 bg-white border rounded-2">
                    <code class="fw-bold text-primary">{{ROUTER_NAME}}</code>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">Nama identitas perangkat router</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="p-2.5 bg-white border rounded-2">
                    <code class="fw-bold text-primary">{{DATE}}</code>
                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">Tanggal & Waktu Generate</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template Cards Grid -->
<div class="row g-3">
    <% templates.forEach(function(template) { %>
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom py-3 px-3 px-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-primary p-2 rounded-2 text-white">
                            <i class="bi bi-file-earmark-code fs-5"></i>
                        </span>
                        <div>
                            <h6 class="fw-bold text-dark mb-0"><%= template.name %></h6>
                            <code class="text-muted small">Slug: <%= template.slug %></code>
                        </div>
                    </div>
                    <div>
                        <% if (template.is_active) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                                <i class="bi bi-check-circle-fill me-1"></i> Aktif
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small">
                                Nonaktif
                            </span>
                        <% } %>
                    </div>
                </div>

                <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                    <div>
                        <p class="text-muted small mb-3">
                            <%= template.description || 'Tidak ada deskripsi.' %>
                        </p>
                        <div class="position-relative mb-3">
                            <pre class="code-box p-3 mb-0" style="max-height: 180px; overflow-y: auto; font-size: 0.78rem;"><code><%= template.content %></code></pre>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top mt-auto">
                        <small class="text-muted">
                            Diperbarui: <%= formatDate(template.updated_at) %>
                        </small>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 py-1 px-2.5" data-bs-toggle="modal" data-bs-target="#editTplModal<%= template.id %>">
                                <i class="bi bi-lightning-charge me-1"></i> Quick Edit
                            </button>
                            <a href="/admin/templates/<%= template.id %>/edit" class="btn btn-sm btn-primary rounded-2 py-1 px-3">
                                <i class="bi bi-pencil-square me-1"></i> Edit Halaman
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Template Modal -->
            <div class="modal fade" id="editTplModal<%= template.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <form action="/admin/templates/<%= template.id %>?_method=PUT" method="POST">
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold">Quick Edit: <%= template.name %></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nama Template</label>
                                    <input type="text" name="name" class="form-control" value="<%= template.name %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Deskripsi</label>
                                    <input type="text" name="description" class="form-control" value="<%= template.description || '' %>">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Isi Script RouterOS</label>
                                    <textarea name="content" class="form-control font-monospace p-3" rows="12" style="background-color: #0f172a; color: #f8fafc;" required><%= template.content %></textarea>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="is_active" value="1" id="swActive<%= template.id %>" <%= template.is_active ? 'checked' : '' %>>
                                    <label class="form-check-label fw-semibold small" for="swActive<%= template.id %>">Aktifkan template ini</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Tutup</button>
                                <button type="submit" class="btn btn-sm btn-primary">Simpan Perubahan</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% }); %>
</div>
