<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin/templates" class="btn btn-light border btn-sm p-2 rounded-2 text-secondary" title="Kembali ke Daftar Template">
            <i class="bi bi-arrow-left fs-6"></i>
        </a>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h3 class="fw-bold mb-0 text-dark">Edit Template: <%= template.name %></h3>
                <code class="badge bg-light text-muted border font-monospace"><%= template.slug %></code>
            </div>
            <p class="text-muted small mb-0">
                Sesuaikan perintah RouterOS dan gunakan placeholder dinamis untuk otomatisasi.
            </p>
        </div>
    </div>
    <% if (template.default_content !== null && template.content !== template.default_content) { %>
        <button type="button" class="btn btn-outline-warning btn-sm d-inline-flex align-items-center gap-1.5 rounded-2" data-bs-toggle="modal" data-bs-target="#resetModal">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset ke Script Bawaan</span>
        </button>
    <% } %>
</div>

<div class="row g-4">
    <!-- Main Editor Column -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form action="/admin/templates/<%= template.id %>?_method=PUT" method="POST">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold text-dark small">Nama Template <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="name" value="<%= template.name %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold text-dark small">Deskripsi Template</label>
                        <textarea class="form-control" id="description" name="description" rows="2"><%= template.description || '' %></textarea>
                        <div class="form-text small text-muted">Penjelasan singkat fungsi script ini untuk pengguna atau teknisi.</div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
                            <label for="content" class="form-label fw-semibold text-dark small mb-0">
                                Isi Script RouterOS <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted small">Klik placeholder di panel kanan untuk menyisipkan otomatis.</span>
                        </div>
                        <textarea class="form-control p-3 font-monospace" id="content" name="content" rows="<%= template.slug === 'scheduler_cmd' ? 4 : 18 %>" required style="tab-size: 4; background-color: #0f172a; color: #f8fafc;"><%= template.content %></textarea>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="is_active" name="is_active" value="1" <%= template.is_active ? 'checked' : '' %>>
                        <label class="form-check-label fw-medium text-dark small" for="is_active">
                            Aktifkan template ini pada generator router pengguna
                        </label>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-primary btn-sm rounded-2 px-3 py-2">
                            <i class="bi bi-check2 me-1"></i> Simpan Perubahan Template
                        </button>
                        <a href="/admin/templates" class="btn btn-light border btn-sm rounded-2 px-3 py-2 text-secondary">
                            Batal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sidebar Helper Column -->
    <div class="col-lg-4">
        <!-- Placeholders Insertion Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-code-square text-primary"></i>
                    <span>Variabel Placeholder</span>
                </h6>
            </div>
            <div class="card-body p-3">
                <p class="text-muted small mb-3">
                    Klik tag di bawah ini untuk langsung menyisipkannya ke dalam posisi kursor script:
                </p>

                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-start d-flex justify-content-between align-items-center p-2 rounded-2 placeholder-tag" onclick="insertVariable('{{TOKEN}}')">
                        <div>
                            <code class="fw-bold text-primary">{{TOKEN}}</code>
                            <div class="text-muted" style="font-size: 0.72rem;">API Token Router (32 char)</div>
                        </div>
                        <i class="bi bi-plus-circle text-muted"></i>
                    </button>

                    <button type="button" class="btn btn-sm btn-light border text-start d-flex justify-content-between align-items-center p-2 rounded-2 placeholder-tag" onclick="insertVariable('{{URL}}')">
                        <div>
                            <code class="fw-bold text-primary">{{URL}}</code>
                            <div class="text-muted" style="font-size: 0.72rem;">URL Web API Upload</div>
                        </div>
                        <i class="bi bi-plus-circle text-muted"></i>
                    </button>

                    <button type="button" class="btn btn-sm btn-light border text-start d-flex justify-content-between align-items-center p-2 rounded-2 placeholder-tag" onclick="insertVariable('{{ROUTER_NAME}}')">
                        <div>
                            <code class="fw-bold text-primary">{{ROUTER_NAME}}</code>
                            <div class="text-muted" style="font-size: 0.72rem;">Nama Perangkat Router</div>
                        </div>
                        <i class="bi bi-plus-circle text-muted"></i>
                    </button>

                    <button type="button" class="btn btn-sm btn-light border text-start d-flex justify-content-between align-items-center p-2 rounded-2 placeholder-tag" onclick="insertVariable('{{DATE}}')">
                        <div>
                            <code class="fw-bold text-primary">{{DATE}}</code>
                            <div class="text-muted" style="font-size: 0.72rem;">Tanggal & Waktu Generate</div>
                        </div>
                        <i class="bi bi-plus-circle text-muted"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Default Script Reference -->
        <% if (template.default_content !== null) { %>
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-archive text-secondary"></i>
                        <span>Script Default Sistem</span>
                    </h6>
                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#defaultScriptCollapse">
                        Lihat / Tutup
                    </button>
                </div>
                <div class="collapse" id="defaultScriptCollapse">
                    <div class="card-body p-3">
                        <pre class="p-3 mb-0 rounded-2" style="max-height: 250px; overflow-y: auto; font-size: 0.72rem; background-color: #0f172a; color: #f8fafc;"><%= template.default_content %></pre>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Reset Modal -->
<% if (template.default_content !== null) { %>
    <div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Kembalikan ke Script Default</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Apakah Anda yakin ingin membatalkan semua perubahan kustom pada template <strong><%= template.name %></strong> dan kembali ke script standar sistem?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Batal</button>
                    <form action="/admin/templates/<%= template.id %>/reset" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning">Ya, Reset Sekarang</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
<% } %>

<script>
    function insertVariable(variableText) {
        const textarea = document.getElementById('content');
        if (!textarea) return;

        const startPos = textarea.selectionStart;
        const endPos = textarea.selectionEnd;
        const textBefore = textarea.value.substring(0, startPos);
        const textAfter = textarea.value.substring(endPos, textarea.value.length);

        textarea.value = textBefore + variableText + textAfter;
        textarea.selectionStart = startPos + variableText.length;
        textarea.selectionEnd = startPos + variableText.length;
        textarea.focus();
    }
</script>
