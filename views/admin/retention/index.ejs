<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0 text-dark">Retensi & Storage</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 small">
                Admin Policy (Express.js)
            </span>
        </div>
        <p class="text-muted small mb-0">
            Aturan batas masa simpan berkas dan kuota backup otomatis untuk seluruh router.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3" onclick="runDryRunSimulation()">
            <i class="bi bi-play-circle text-primary"></i>
            <span>Simulasi</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#executePruneModal">
            <i class="bi bi-trash3"></i>
            <span>Bersihkan Sekarang</span>
        </button>
    </div>
</div>

<!-- Metrics Summary (Clean & Minimalist) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Storage Server</div>
            <h4 class="fw-bold text-dark mb-0"><%= overview.total_size_formatted %></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Berkas</div>
            <h4 class="fw-bold text-dark mb-0"><%= overview.total_backups %> <span class="fs-6 fw-normal text-muted">berkas</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Aturan Aktif</div>
            <h4 class="fw-bold text-dark mb-0"><%= overview.max_months %> Bulan <span class="fs-6 fw-normal text-muted">/ <%= overview.max_days_per_month %> Hari</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Terakhir Dibersihkan</div>
            <h4 class="fw-bold text-dark mb-0" style="font-size: 1.1rem;">
                <%= diffForHumans(overview.last_pruned_at) %>
            </h4>
        </div>
    </div>
</div>

<!-- Middle Row: Settings Form (Left) & Monthly Distribution (Right) -->
<div class="row g-4 mb-4">
    <!-- Form Pengaturan Retensi -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Pengaturan Kebijakan</h5>
                </div>
                <span class="badge bg-light text-muted border small">
                    Batas: <%= overview.cutoff_date_formatted %>
                </span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <form action="/admin/retention?_method=PUT" method="POST">
                    <!-- Masa Simpan (Bulan) -->
                    <div class="mb-3">
                        <label for="retention_max_months" class="form-label fw-bold text-dark small mb-1">
                            Masa Simpan (Bulan)
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <input type="number" name="retention_max_months" id="retention_max_months" 
                                   class="form-control form-control-sm" 
                                   value="<%= overview.max_months %>" 
                                   min="1" max="60" required>
                            <span class="input-group-text bg-light text-muted">Bulan</span>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Hapus backup yang lebih lama dari durasi ini.
                        </div>
                    </div>

                    <!-- Kuota Hari per Bulan -->
                    <div class="mb-3.5">
                        <label for="retention_max_days_per_month" class="form-label fw-bold text-dark small mb-1">
                            Batas Hari per Bulan
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-calendar-week"></i>
                            </span>
                            <input type="number" name="retention_max_days_per_month" id="retention_max_days_per_month" 
                                   class="form-control form-control-sm" 
                                   value="<%= overview.max_days_per_month %>" 
                                   min="1" max="31" required>
                            <span class="input-group-text bg-light text-muted">Hari Unik</span>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Simpan maksimal 7 hari terbaru per bulan (FIFO). Tidak ada penambahan = tidak dihapus.
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-2 border mb-3 mt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="retention_auto_prune_enabled" 
                                   name="retention_auto_prune_enabled" value="1" 
                                   <%= overview.auto_prune_enabled ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold text-dark small" for="retention_auto_prune_enabled">
                                Pembersihan Harian (00:05 WIB)
                            </label>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="retention_prune_on_upload" 
                                   name="retention_prune_on_upload" value="1" 
                                   <%= overview.prune_on_upload ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold text-dark small" for="retention_prune_on_upload">
                                Pangkas Realtime Saat Upload Baru
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-sm px-4 rounded-2 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Simpan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Distribusi Penyimpanan Berdasarkan Bulan (Clean & Minimalist Table) -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar2-range text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Distribusi Penyimpanan Berdasarkan Bulan</h5>
                </div>
                <span class="badge bg-light text-muted border small">Rentang 6 Bulan</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4">Bulan</th>
                            <th class="text-center">Router</th>
                            <th class="text-center">Berkas</th>
                            <th class="text-end">Ukuran</th>
                            <th class="pe-4 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (overview.months_distribution && overview.months_distribution.length > 0) { %>
                            <% overview.months_distribution.forEach(function(m) { %>
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <%= m.label %>
                                    </td>
                                    <td class="text-center text-muted">
                                        <% if (m.routers_count > 0) { %>
                                            <%= m.routers_count %>
                                        <% } else { %>
                                            <span class="text-muted opacity-50">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center text-dark">
                                        <% if (m.backups_count > 0) { %>
                                            <span class="fw-semibold"><%= m.backups_count %></span>
                                        <% } else { %>
                                            <span class="text-muted opacity-50">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end font-monospace small">
                                        <% if (m.size_bytes > 0) { %>
                                            <span class="text-primary fw-semibold"><%= m.size_formatted %></span>
                                        <% } else { %>
                                            <span class="text-muted opacity-50">—</span>
                                        <% } %>
                                    </td>
                                    <td class="pe-4 text-center">
                                        <% if (m.is_retained) { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                                Aktif
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                                Kedaluwarsa
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">
                                    Belum ada data distribusi bulanan.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Storage Breakdown per Router Table -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hdd-network text-primary"></i>
            <h5 class="fw-bold mb-0 text-dark">Penggunaan Storage per Router</h5>
        </div>
        <span class="badge bg-light text-muted border small"><%= overview.routers_breakdown.length %> Router</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
            <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-4">Nama Router</th>
                    <th>Pemilik</th>
                    <th class="text-center">Jumlah Berkas</th>
                    <th class="text-end">Ukuran Disk</th>
                    <th class="text-center">Backup Terbaru</th>
                    <th class="pe-4 text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (overview.routers_breakdown.length > 0) { %>
                    <% overview.routers_breakdown.forEach(function(r) { %>
                        <tr>
                            <td class="ps-4">
                                <a href="/routers/<%= r.id %>" class="fw-bold text-decoration-none text-dark d-inline-flex align-items-center gap-1.5">
                                    <i class="bi bi-router text-primary"></i>
                                    <span><%= r.name %></span>
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-person me-1"></i><%= r.owner %>
                                </span>
                            </td>
                            <td class="text-center fw-semibold text-dark">
                                <%= r.backups_count %>
                            </td>
                            <td class="text-end font-monospace small fw-semibold text-primary">
                                <%= r.total_size_formatted %>
                            </td>
                            <td class="text-center text-muted small">
                                <%= r.newest_backup %>
                            </td>
                            <td class="pe-4 text-center">
                                <a href="/routers/<%= r.id %>" class="btn btn-xs btn-outline-primary py-1 px-2.5 rounded-2">
                                    Detail Router <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted small">
                            Belum ada router yang terdaftar.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Dry-Run Simulation Results -->
<div class="modal fade" id="dryRunModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary p-2 rounded-2">
                        <i class="bi bi-play-circle fs-6"></i>
                    </span>
                    <div>
                        <h6 class="modal-title fw-bold text-white mb-0">Hasil Simulasi Pembersihan</h6>
                        <small class="text-white-50">Pratinjau berkas kedaluwarsa tanpa mengubah data fisik.</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center py-4" id="dryRunLoading">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted small mb-0">Sedang memindai berkas backup...</p>
                </div>

                <div id="dryRunContent" class="d-none">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-2 border">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Berkas Kedaluwarsa</div>
                                <h4 class="fw-bold text-danger mb-0" id="dryRunCount">0 berkas</h4>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-2 border">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Estimasi Ruang Dihemat</div>
                                <h4 class="fw-bold text-success mb-0" id="dryRunBytes">0 B</h4>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive border rounded-2" style="max-height: 280px;">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.8rem;">
                            <thead class="table-light text-muted sticky-top">
                                <tr>
                                    <th>Router</th>
                                    <th>Nama Berkas</th>
                                    <th>Waktu Buat</th>
                                    <th>Alasan</th>
                                </tr>
                            </thead>
                            <tbody id="dryRunTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top bg-light py-2.5 px-4 d-flex justify-content-between">
                <button type="button" class="btn btn-sm btn-secondary rounded-2" data-bs-dismiss="modal">Tutup</button>
                <form action="/admin/retention/prune" method="POST" id="executeFromDryRunForm" class="d-none">
                    <button type="submit" class="btn btn-sm btn-danger rounded-2 fw-semibold">
                        <i class="bi bi-trash3 me-1"></i> Eksekusi Hapus Sekarang
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Execute Live Prune Confirmation -->
<div class="modal fade" id="executePruneModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    Konfirmasi Pembersihan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dark mb-2">
                    Jalankan pembersihan retensi backup sekarang?
                </p>
                <div class="alert alert-warning small border-0 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Menghapus berkas yang lebih tua dari <strong><%= overview.max_months %> bulan</strong> atau melebihi kuota <strong><%= overview.max_days_per_month %> hari</strong> unik terbaru per bulan.
                </div>
            </div>
            <div class="modal-footer border-top bg-light py-2.5 px-4">
                <button type="button" class="btn btn-sm btn-secondary rounded-2" data-bs-dismiss="modal">Batal</button>
                <form action="/admin/retention/prune" method="POST">
                    <button type="submit" class="btn btn-sm btn-primary rounded-2 fw-semibold">
                        <i class="bi bi-trash3 me-1"></i> Ya, Jalankan
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function runDryRunSimulation() {
        const modal = new bootstrap.Modal(document.getElementById('dryRunModal'));
        modal.show();

        const loading = document.getElementById('dryRunLoading');
        const content = document.getElementById('dryRunContent');
        const execForm = document.getElementById('executeFromDryRunForm');
        const countEl = document.getElementById('dryRunCount');
        const bytesEl = document.getElementById('dryRunBytes');
        const tbody = document.getElementById('dryRunTableBody');

        loading.classList.remove('d-none');
        content.classList.add('d-none');
        execForm.classList.add('d-none');

        fetch('/admin/retention/prune?dry_run=1', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(json => {
            loading.classList.add('d-none');
            content.classList.remove('d-none');

            if (json.success && json.data) {
                const data = json.data;
                countEl.textContent = `${data.total_files_pruned} berkas`;
                bytesEl.textContent = data.total_bytes_saved_formatted;

                tbody.innerHTML = '';
                if (data.details && data.details.length > 0) {
                    execForm.classList.remove('d-none');
                    data.details.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="fw-semibold text-dark">${item.router_name}</td>
                            <td class="font-monospace small text-muted">${item.filename}</td>
                            <td class="small">${item.created_at}</td>
                            <td><span class="badge bg-warning-subtle text-warning-emphasis">${item.reason}</span></td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">
                                <i class="bi bi-check-circle-fill text-success fs-5 d-block mb-1"></i>
                                Tidak ada berkas kedaluwarsa. Seluruh file berada dalam kuota retensi yang valid.
                            </td>
                        </tr>
                    `;
                }
            }
        })
        .catch(err => {
            loading.classList.add('d-none');
            alert('Gagal menjalankan simulasi: ' + err.message);
        });
    }
</script>