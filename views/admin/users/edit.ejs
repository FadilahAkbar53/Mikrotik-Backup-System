<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="fw-bold mb-0">Edit Pengguna</h4>
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm rounded-2">
                <i class="bi bi-arrow-left me-1"></i> Batal
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form action="/admin/users/<%= targetUser.id %>?_method=PUT" method="POST" autocomplete="off">
                    <!-- Dummy hidden fields to prevent aggressive browser autofill -->
                    <input type="text" style="display:none;" tabindex="-1" aria-hidden="true" autocomplete="off">
                    <input type="password" style="display:none;" tabindex="-1" aria-hidden="true" autocomplete="new-password">

                    <div class="mb-3">
                        <label for="name" class="form-label fw-bold small text-dark">Nama Pengguna</label>
                        <input type="text" class="form-control" id="name" name="name" value="<%= targetUser.name %>" autocomplete="off" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold small text-dark">Alamat Email</label>
                        <input type="email" class="form-control" id="email" name="email" value="<%= targetUser.email %>" autocomplete="off" required>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-bold small text-dark">Ganti Kata Sandi (Opsional)</label>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Kosongkan jika tidak ingin mengubah password" autocomplete="new-password" minlength="8">
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label fw-bold small text-dark">Hak Akses (Role)</label>
                        <select name="role" id="role" class="form-select" <%= targetUser.id === currentUser.id ? 'disabled' : '' %> required>
                            <option value="user" <%= targetUser.role === 'user' ? 'selected' : '' %>>Tenant / User Biasa</option>
                            <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Administrator Sistem</option>
                        </select>
                        <% if (targetUser.id === currentUser.id) { %>
                            <input type="hidden" name="role" value="admin">
                        <% } %>
                    </div>

                    <div class="mb-4">
                        <label for="is_active" class="form-label fw-bold small text-dark">Status Akun</label>
                        <select name="is_active" id="is_active" class="form-select" <%= targetUser.id === currentUser.id ? 'disabled' : '' %>>
                            <option value="1" <%= targetUser.is_active !== 0 ? 'selected' : '' %>>Aktif (Bisa Login & Backup)</option>
                            <option value="0" <%= targetUser.is_active === 0 ? 'selected' : '' %>>Dinonaktifkan / Suspended</option>
                        </select>
                        <% if (targetUser.id === currentUser.id) { %>
                            <small class="text-muted fst-italic">Anda tidak dapat menonaktifkan akun Anda sendiri.</small>
                            <input type="hidden" name="is_active" value="1">
                        <% } else { %>
                            <small class="text-muted">Akun dinonaktifkan ditolak login ke web dan ditolak upload FTP MikroTik.</small>
                        <% } %>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold py-2 rounded-2">
                            <i class="bi bi-check-lg me-1"></i> Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>