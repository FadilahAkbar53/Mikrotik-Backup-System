<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="fw-bold mb-0">Tambah Pengguna Baru</h4>
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm rounded-2">
                <i class="bi bi-arrow-left me-1"></i> Kembali
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form action="/admin/users" method="POST" autocomplete="off">
                    <!-- Dummy hidden fields to trick aggressive browser autofill -->
                    <div style="opacity: 0; position: absolute; top: -9999px; left: -9999px; width: 0; height: 0; overflow: hidden; pointer-events: none;" aria-hidden="true">
                        <input type="text" name="fake_username_remember" tabindex="-1" autocomplete="username">
                        <input type="password" name="fake_password_remember" tabindex="-1" autocomplete="current-password">
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label fw-bold small text-dark">Nama Pengguna</label>
                        <input type="text" class="form-control" id="name" name="name" placeholder="Nama lengkap" autocomplete="off" data-lpignore="true" readonly onfocus="this.removeAttribute('readonly');" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold small text-dark">Alamat Email</label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="email@perusahaan.com" autocomplete="off" data-lpignore="true" readonly onfocus="this.removeAttribute('readonly');" required>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-bold small text-dark">Kata Sandi (Min. 8 Karakter)</label>
                        <input type="password" class="form-control" id="password" name="password" minlength="8" autocomplete="new-password" data-lpignore="true" readonly onfocus="this.removeAttribute('readonly');" required>
                    </div>

                    <div class="mb-4">
                        <label for="role" class="form-label fw-bold small text-dark">Hak Akses (Role)</label>
                        <select name="role" id="role" class="form-select" required>
                            <option value="user" selected>Tenant / User Biasa</option>
                            <option value="admin">Administrator Sistem</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold py-2 rounded-2">
                            <i class="bi bi-person-plus me-1"></i> Simpan Pengguna
                        </button>
                    </div>
                </form>

                <script>
                    // Ensure form inputs start blank even if browser autofills
                    document.addEventListener('DOMContentLoaded', function() {
                        setTimeout(function() {
                            const name = document.getElementById('name');
                            const email = document.getElementById('email');
                            const pwd = document.getElementById('password');
                            if (pwd && pwd.value) pwd.value = '';
                            if (name && name.value && name.value.includes('@')) name.value = '';
                        }, 150);
                    });
                </script>
            </div>
        </div>
    </div>
</div>