<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0 text-dark">Pengaturan Aplikasi Terpusat</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-0.5 small">
                Global System Config
            </span>
        </div>
        <p class="text-muted small mb-0">
            Kelola konfigurasi nama aplikasi, domain, parameter transmisi FTP MikroTik, ambang batas monitoring kesehatan, dan akses akun secara terpusat.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/admin/retention" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-database-fill-gear"></i>
            <span>Retensi Storage</span>
        </a>
        <a href="/admin/logs" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-journal-text"></i>
            <span>Log Sistem</span>
        </a>
    </div>
</div>

<form action="/admin/settings" method="POST">
    <div class="row g-4">
        <!-- 1. Identitas & Domain Aplikasi -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-globe-americas text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Identitas & Akses Web</h5>
                </div>
                <div class="card-body p-4">
                    <!-- Nama Aplikasi -->
                    <div class="mb-3.5">
                        <label for="app_name" class="form-label fw-bold text-dark small mb-1">
                            Nama Aplikasi / Branding
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-tag-fill"></i>
                            </span>
                            <input type="text" name="app_name" id="app_name" 
                                   class="form-control" 
                                   value="<%= settings.app_name %>" 
                                   placeholder="Contoh: MikBack" required>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Nama yang ditampilkan pada tab browser, sidebar, dan header aplikasi.
                        </div>
                    </div>

                    <!-- URL / Domain Web -->
                    <div class="mb-3.5">
                        <label for="app_url" class="form-label fw-bold text-dark small mb-1">
                            Domain / URL Aplikasi
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-link-45deg"></i>
                            </span>
                            <input type="url" name="app_url" id="app_url" 
                                   class="form-control" 
                                   value="<%= settings.app_url %>" 
                                   placeholder="https://mikback.terrafa.tech" required>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            URL publik sistem untuk referensi webhook, API, dan script generator.
                        </div>
                    </div>

                    <!-- Zona Waktu -->
                    <div class="mb-2">
                        <label for="app_timezone" class="form-label fw-bold text-dark small mb-1">
                            Zona Waktu Operasional
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-clock"></i>
                            </span>
                            <select name="app_timezone" id="app_timezone" class="form-select">
                                <option value="Asia/Jakarta" <%= settings.app_timezone === 'Asia/Jakarta' ? 'selected' : '' %>>Asia/Jakarta (WIB - UTC+7)</option>
                                <option value="Asia/Makassar" <%= settings.app_timezone === 'Asia/Makassar' ? 'selected' : '' %>>Asia/Makassar (WITA - UTC+8)</option>
                                <option value="Asia/Jayapura" <%= settings.app_timezone === 'Asia/Jayapura' ? 'selected' : '' %>>Asia/Jayapura (WIT - UTC+9)</option>
                                <option value="UTC" <%= settings.app_timezone === 'UTC' ? 'selected' : '' %>>UTC</option>
                            </select>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Standar waktu untuk pencatatan log audit dan pelaporan voucher.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Parameter Transmisi FTP MikroTik -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-hdd-network text-info fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Koneksi Daemon FTP MikroTik</h5>
                </div>
                <div class="card-body p-4">
                    <!-- Hostname / IP FTP -->
                    <div class="mb-3.5">
                        <label for="ftp_host" class="form-label fw-bold text-dark small mb-1">
                            Alamat Host / Domain FTP
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-server"></i>
                            </span>
                            <input type="text" name="ftp_host" id="ftp_host" 
                                   class="form-control" 
                                   value="<%= settings.ftp_host %>" 
                                   placeholder="Contoh: mikback.terrafa.tech atau 187.52.122.246" required>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Host tujuan yang disisipkan ke perintah <code>/tool fetch mode=ftp</code> pada script MikroTik.
                        </div>
                    </div>

                    <!-- Port FTP -->
                    <div class="mb-3.5">
                        <label for="ftp_port" class="form-label fw-bold text-dark small mb-1">
                            Port Daemon FTP Listener
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-hash"></i>
                            </span>
                            <input type="number" name="ftp_port" id="ftp_port" 
                                   class="form-control" 
                                   value="<%= settings.ftp_port %>" 
                                   min="21" max="65535" required>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Port native FTP receiver (Default: <code>2121</code>). Pastikan port ini terbuka di firewall VPS.
                        </div>
                    </div>

                    <!-- FTP Notice Box -->
                    <div class="alert alert-light border py-2.5 px-3 small rounded-2 mb-0 d-flex gap-2 align-items-start">
                        <i class="bi bi-info-circle text-primary flex-shrink-0 mt-0.5"></i>
                        <span class="text-secondary" style="font-size: 0.75rem;">
                            Perubahan Host dan Port FTP akan langsung otomatis memperbarui hasil generate script backup untuk seluruh router baru maupun lama tanpa perlu merestart server.
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Monitoring Kesehatan & Jadwal Rekomendasi -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-heart-pulse text-danger fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Ambang Batas Monitoring & Script</h5>
                </div>
                <div class="card-body p-4">
                    <!-- Ambang Batas Waktu Router Sehat -->
                    <div class="mb-3.5">
                        <label for="health_threshold_hours" class="form-label fw-bold text-dark small mb-1">
                            Batas Toleransi Router Sehat (Jam)
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-hourglass-split"></i>
                            </span>
                            <input type="number" name="health_threshold_hours" id="health_threshold_hours" 
                                   class="form-control" 
                                   value="<%= settings.health_threshold_hours %>" 
                                   min="1" max="168" required>
                            <span class="input-group-text bg-light text-muted">Jam</span>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Router yang tidak mengirimkan backup melebihi batas ini akan diberi label <strong>"Perlu Perhatian" (Kuning/Merah)</strong> di Dashboard.
                        </div>
                    </div>

                    <!-- Jam Rekomendasi Backup -->
                    <div class="mb-3.5">
                        <label for="backup_recommendation_time" class="form-label fw-bold text-dark small mb-1">
                            Waktu Eksekusi Rekomendasi (Scheduler)
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-alarm"></i>
                            </span>
                            <input type="text" name="backup_recommendation_time" id="backup_recommendation_time" 
                                   class="form-control font-monospace" 
                                   value="<%= settings.backup_recommendation_time %>" 
                                   placeholder="02:00:00" required>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Jam default pada generator script (Direkomendasikan jam sepi aktivitas, misal <code>02:00:00</code> subuh).
                        </div>
                    </div>

                    <!-- Template Script Default -->
                    <div class="mb-2">
                        <label for="default_script_template" class="form-label fw-bold text-dark small mb-1">
                            Template Script Default Router
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-file-earmark-code"></i>
                            </span>
                            <select name="default_script_template" id="default_script_template" class="form-select">
                                <% if (templates && templates.length > 0) { %>
                                    <% templates.forEach(function(tpl) { %>
                                        <option value="<%= tpl.slug %>" <%= settings.default_script_template === tpl.slug ? 'selected' : '' %>>
                                            <%= tpl.name %> (<%= tpl.slug %>)
                                        </option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="one_click_setup">Scheduler All-in-One (one_click_setup)</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.76rem;">
                            Template yang terpilih otomatis saat tenant membuka tab Script Generator router.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Keamanan & Kebijakan Akun Tenant -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock text-success fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Akses & Pendaftaran Pengguna</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Sakelar Pendaftaran Terbuka -->
                        <div class="p-3 border rounded-3 bg-light-subtle mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" name="allow_registration" id="allow_registration" value="1" <%= settings.allow_registration === '1' ? 'checked' : '' %>>
                                <label class="form-check-label fw-bold text-dark" for="allow_registration">
                                    Buka Pendaftaran Akun Tenant Baru (Publik)
                                </label>
                            </div>
                            <p class="text-secondary small mb-0" style="font-size: 0.78rem;">
                                Jika diaktifkan, pengunjung dapat membuat akun mandiri via <code>/register</code>. Jika dimatikan, pendaftaran publik ditutup dan hanya Administrator yang dapat mendaftarkan akun baru melalui panel admin.
                            </p>
                        </div>

                        <!-- Info Keamanan -->
                        <div class="p-3 border rounded-3 bg-white">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-key-fill text-warning"></i>
                                <span class="fw-bold text-dark small">Autentikasi Token Router</span>
                            </div>
                            <p class="text-muted small mb-0" style="font-size: 0.75rem;">
                                Seluruh router menggunakan token unik 128-bit acak untuk autentikasi FTP maupun API. Token tidak kadaluarsa kecuali di-reset manual oleh tenant atau admin.
                            </p>
                        </div>
                    </div>

                    <!-- Tombol Submit Form -->
                    <div class="pt-3 border-top border-light mt-4 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary rounded-2 px-4 d-inline-flex align-items-center gap-2 shadow-sm">
                            <i class="bi bi-check2-circle fs-6"></i>
                            <span>Simpan Semua Pengaturan</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
