<!-- Script Logic for RSC Previewer -->
<script>
    let currentRscBackupId = null;
    let rawRscScriptContent = '';
    let currentRscFontSize = 14;
    let isRscWordWrap = false;
    let isRscFullscreen = false;
    let isRawTextMode = false;
    let rscMaxLinesRendered = 2500; // Fast initial limit for huge scripts

    /**
     * Open RSC Script Preview Modal by Backup ID
     */
    function openRscPreview(backupId) {
        currentRscBackupId = backupId;
        const modalEl = document.getElementById('rscPreviewModal');
        if (!modalEl) return;

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        loadRscScript(backupId);
    }

    /**
     * Fetch RSC script content from server
     */
    function loadRscScript(backupId) {
        const loadingState = document.getElementById('rscLoadingState');
        const errorState = document.getElementById('rscErrorState');
        const codeWrapper = document.getElementById('rscCodeWrapper');
        const searchInput = document.getElementById('rscSearchInput');
        const searchCount = document.getElementById('rscSearchCount');
        const truncatedBanner = document.getElementById('rscTruncatedBanner');

        if (loadingState) loadingState.classList.remove('d-none');
        if (errorState) errorState.classList.add('d-none');
        if (codeWrapper) codeWrapper.classList.add('d-none');
        if (truncatedBanner) truncatedBanner.classList.add('d-none');
        if (searchInput) searchInput.value = '';
        if (searchCount) searchCount.classList.add('d-none');
        const prevBtn = document.getElementById('rscSearchPrevBtn');
        const nextBtn = document.getElementById('rscSearchNextBtn');
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;
        rscCurrentMatchIdx = 0;
        rscTotalMatches = 0;

        fetch(`/backup/preview/${backupId}`, {
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(data => {
                    throw new Error(data.message || `Gagal memuat script (Status ${response.status})`);
                });
            }
            return response.json();
        })
        .then(data => {
            if (!data.success) {
                throw new Error(data.message || 'Gagal membaca berkas script.');
            }

            // Populate metadata
            document.getElementById('rscModalFilename').textContent = data.filename;
            document.getElementById('rscModalRouter').textContent = data.router_name;
            
            const ownerBadge = document.getElementById('rscModalOwnerBadge');
            const ownerEl = document.getElementById('rscModalOwner');
            if (data.owner_name && data.owner_name !== 'N/A') {
                if (ownerEl) ownerEl.textContent = data.owner_name;
                if (ownerBadge) ownerBadge.classList.remove('d-none');
            } else if (ownerBadge) {
                ownerBadge.classList.add('d-none');
            }

            document.getElementById('rscModalSize').textContent = data.size;
            document.getElementById('rscModalDate').textContent = data.created_at;
            document.getElementById('rscModalLines').textContent = data.lines_count.toLocaleString();
            
            const downloadBtn = document.getElementById('rscDownloadBtn');
            if (downloadBtn) {
                downloadBtn.href = data.download_url;
            }

            // Store raw content
            rawRscScriptContent = data.content || '';

            // Reset lines render limit
            rscMaxLinesRendered = 2500;

            // Render code
            renderRscContent();

            if (loadingState) loadingState.classList.add('d-none');
            if (codeWrapper) codeWrapper.classList.remove('d-none');
        })
        .catch(err => {
            if (loadingState) loadingState.classList.add('d-none');
            if (errorState) {
                errorState.classList.remove('d-none');
                const errMsgEl = document.getElementById('rscErrorMessage');
                if (errMsgEl) errMsgEl.textContent = err.message || 'Terjadi kesalahan jaringan atau server saat membaca berkas script.';
            }
        });
    }

    function retryRscPreview() {
        if (currentRscBackupId) {
            loadRscScript(currentRscBackupId);
        }
    }

    /**
     * Escape HTML special characters
     */
    function escapeHtml(text) {
        if (!text) return '';
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    let rscAllMatches = [];
    let rscCurrentMatchIdx = 0;
    let rscTotalMatches = 0;

    /**
     * Fast in-memory full script search (runs in ~6ms across 79,000 lines)
     */
    function findScriptMatches(cleanTerm) {
        if (!cleanTerm) return [];
        const escaped = cleanTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp(escaped, 'gi');
        const allLines = rawRscScriptContent.split(/\r?\n/);
        const matches = [];

        for (let i = 0; i < allLines.length; i++) {
            regex.lastIndex = 0;
            let m;
            while ((m = regex.exec(allLines[i])) !== null) {
                matches.push({
                    matchIdx: matches.length,
                    lineIdx: i,
                    lineNum: i + 1,
                    col: m.index,
                    text: m[0]
                });
            }
        }
        return matches;
    }

    /**
     * Helper to highlight non-search chunks into MikroTik syntax tokens
     */
    function highlightMikroTikTokens(chunk) {
        if (!chunk) return '';
        const tokenPattern = /("(?:\\\\.|[^"\\\\])*")|(\b[a-zA-Z0-9_\-]+(?==))|(\b(?:add|set|remove|find|enable|disable|print|export|get|move)\b)|(\b\d{1,3}(?:\.\d{1,3}){3}(?:\/\d{1,2})?\b)|(\$[a-zA-Z0-9_\-]+)/g;
        let match;
        let lastIdx = 0;
        let out = '';
        while ((match = tokenPattern.exec(chunk)) !== null) {
            if (match.index > lastIdx) {
                out += escapeHtml(chunk.substring(lastIdx, match.index));
            }
            let type = 'text';
            if (match[1]) type = 'string';
            else if (match[2]) type = 'key';
            else if (match[3]) type = 'verb';
            else if (match[4]) type = 'ip';
            else if (match[5]) type = 'var';
            out += `<span class="rsc-${type}">${escapeHtml(match[0])}</span>`;
            lastIdx = match.index + match[0].length;
        }
        if (lastIdx < chunk.length) {
            out += escapeHtml(chunk.substring(lastIdx));
        }
        return out;
    }

    /**
     * Robust Token-based Lexer with Any-Text Search Matching
     * Accurately renders syntax tokens with search marks up to maxLines (defaults to 2,500 or active match line).
     */
    function highlightMikroTikScript(scriptText, searchTerm = '', maxLines = 2500) {
        const allLines = scriptText.split(/\r?\n/);
        const totalLinesCount = allLines.length;

        const cleanTerm = (searchTerm || '').trim();
        const hasSearch = cleanTerm.length > 0;
        const searchRegex = hasSearch ? new RegExp(cleanTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi') : null;

        // Render up to maxLines to keep DOM lightweight and instantaneous
        const linesToProcess = (maxLines && maxLines > 0) ? allLines.slice(0, maxLines) : allLines;

        const highlightedLines = [];
        const lineNumbers = [];
        let matchCount = 0;

        linesToProcess.forEach((line, index) => {
            lineNumbers.push(index + 1);
            const trimmed = line.trim();

            // 1. Comment line
            if (trimmed.startsWith('#')) {
                if (hasSearch && searchRegex.test(line)) {
                    searchRegex.lastIndex = 0;
                    let lastIdx = 0;
                    let m;
                    let lineOut = '';
                    while ((m = searchRegex.exec(line)) !== null) {
                        if (m.index > lastIdx) {
                            lineOut += escapeHtml(line.substring(lastIdx, m.index));
                        }
                        lineOut += `<mark class="rsc-highlight" data-match-idx="${matchCount++}">${escapeHtml(m[0])}</mark>`;
                        lastIdx = m.index + m[0].length;
                    }
                    if (lastIdx < line.length) {
                        lineOut += escapeHtml(line.substring(lastIdx));
                    }
                    highlightedLines.push(`<span class="rsc-comment">${lineOut}</span>`);
                } else {
                    highlightedLines.push(`<span class="rsc-comment">${escapeHtml(line)}</span>`);
                }
                return;
            }

            // 2. Section command path (e.g. /interface ovpn-client, /ip firewall mangle)
            if (trimmed.startsWith('/')) {
                if (hasSearch && searchRegex.test(line)) {
                    searchRegex.lastIndex = 0;
                    let lastIdx = 0;
                    let m;
                    let lineOut = '';
                    while ((m = searchRegex.exec(line)) !== null) {
                        if (m.index > lastIdx) {
                            lineOut += escapeHtml(line.substring(lastIdx, m.index));
                        }
                        lineOut += `<mark class="rsc-highlight" data-match-idx="${matchCount++}">${escapeHtml(m[0])}</mark>`;
                        lastIdx = m.index + m[0].length;
                    }
                    if (lastIdx < line.length) {
                        lineOut += escapeHtml(line.substring(lastIdx));
                    }
                    highlightedLines.push(`<span class="rsc-path">${lineOut}</span>`);
                } else {
                    highlightedLines.push(`<span class="rsc-path">${escapeHtml(line)}</span>`);
                }
                return;
            }

            // 3. Normal configuration lines
            if (hasSearch && searchRegex.test(line)) {
                searchRegex.lastIndex = 0;
                let lastIdx = 0;
                let m;
                let lineOut = '';
                while ((m = searchRegex.exec(line)) !== null) {
                    if (m.index > lastIdx) {
                        lineOut += highlightMikroTikTokens(line.substring(lastIdx, m.index));
                    }
                    lineOut += `<mark class="rsc-highlight" data-match-idx="${matchCount++}">${escapeHtml(m[0])}</mark>`;
                    lastIdx = m.index + m[0].length;
                }
                if (lastIdx < line.length) {
                    lineOut += highlightMikroTikTokens(line.substring(lastIdx));
                }
                highlightedLines.push(lineOut);
            } else {
                highlightedLines.push(highlightMikroTikTokens(line));
            }
        });

        return {
            html: highlightedLines.join('\n'),
            lineNumbersText: lineNumbers.join('\n'),
            matches: matchCount,
            totalLines: totalLinesCount,
            displayedLines: linesToProcess.length,
            isTruncated: totalLinesCount > linesToProcess.length
        };
    }

    /**
     * Render either highlighted code or pure raw text
     */
    function renderRscContent(searchTerm = '', preserveActiveIndex = false) {
        const codeEl = document.getElementById('rscCodeContent');
        const linesEl = document.getElementById('rscLinesCol');
        const truncatedBanner = document.getElementById('rscTruncatedBanner');

        if (!codeEl || !linesEl) return;
        const cleanTerm = (searchTerm || '').trim();
        const hasSearch = cleanTerm.length > 0;

        if (hasSearch) {
            rscAllMatches = findScriptMatches(cleanTerm);
            rscTotalMatches = rscAllMatches.length;
            if (!preserveActiveIndex) {
                rscCurrentMatchIdx = 0;
            } else if (rscCurrentMatchIdx >= rscTotalMatches) {
                rscCurrentMatchIdx = Math.max(0, rscTotalMatches - 1);
            }
        } else {
            rscAllMatches = [];
            rscTotalMatches = 0;
            rscCurrentMatchIdx = 0;
        }

        // Determine how many lines to render
        let linesToRender = rscMaxLinesRendered;
        if (hasSearch && rscTotalMatches > 0 && rscMaxLinesRendered > 0) {
            const activeMatch = rscAllMatches[rscCurrentMatchIdx];
            if (activeMatch) {
                linesToRender = Math.max(2500, activeMatch.lineNum + 50);
            }
        }

        if (isRawTextMode) {
            // Mode Teks Murni (with search highlights support)
            const allLines = rawRscScriptContent.split(/\r?\n/);
            const linesToProcess = (linesToRender > 0) ? allLines.slice(0, linesToRender) : allLines;
            
            const lineNumbers = [];
            for (let i = 1; i <= linesToProcess.length; i++) {
                lineNumbers.push(i);
            }
            linesEl.textContent = lineNumbers.join('\n');

            if (hasSearch) {
                const searchRegex = new RegExp(cleanTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
                let matchCount = 0;
                const outLines = [];
                linesToProcess.forEach(line => {
                    searchRegex.lastIndex = 0;
                    if (searchRegex.test(line)) {
                        searchRegex.lastIndex = 0;
                        let lastIdx = 0;
                        let m;
                        let lineOut = '';
                        while ((m = searchRegex.exec(line)) !== null) {
                            if (m.index > lastIdx) {
                                lineOut += escapeHtml(line.substring(lastIdx, m.index));
                            }
                            lineOut += `<mark class="rsc-highlight" data-match-idx="${matchCount++}">${escapeHtml(m[0])}</mark>`;
                            lastIdx = m.index + m[0].length;
                        }
                        if (lastIdx < line.length) {
                            lineOut += escapeHtml(line.substring(lastIdx));
                        }
                        outLines.push(lineOut);
                    } else {
                        outLines.push(escapeHtml(line));
                    }
                });
                codeEl.innerHTML = outLines.join('\n');
            } else {
                codeEl.textContent = linesToProcess.join('\n');
            }

            if (truncatedBanner) truncatedBanner.classList.add('d-none');
        } else {
            // Mode Syntax Highlighting
            const result = highlightMikroTikScript(rawRscScriptContent, searchTerm, linesToRender);
            codeEl.innerHTML = result.html;
            linesEl.textContent = result.lineNumbersText;

            if (truncatedBanner) {
                if (result.isTruncated && !hasSearch) {
                    truncatedBanner.classList.remove('d-none');
                    document.getElementById('rscDisplayedLinesCount').textContent = result.displayedLines.toLocaleString();
                    document.getElementById('rscTotalLinesBanner').textContent = result.totalLines.toLocaleString();
                } else {
                    truncatedBanner.classList.add('d-none');
                }
            }
        }

        updateSearchUI();
    }

    /**
     * Update Search UI counter and next/prev button states
     */
    function updateSearchUI() {
        const countEl = document.getElementById('rscSearchCount');
        const prevBtn = document.getElementById('rscSearchPrevBtn');
        const nextBtn = document.getElementById('rscSearchNextBtn');
        const searchInput = document.getElementById('rscSearchInput');
        const term = searchInput ? searchInput.value.trim() : '';

        if (!term) {
            if (countEl) countEl.classList.add('d-none');
            if (prevBtn) prevBtn.disabled = true;
            if (nextBtn) nextBtn.disabled = true;
            document.querySelectorAll('.rsc-highlight.rsc-highlight-active').forEach(el => {
                el.classList.remove('rsc-highlight-active');
            });
            return;
        }

        if (countEl) {
            countEl.classList.remove('d-none');
            if (rscTotalMatches > 0) {
                countEl.textContent = `${rscCurrentMatchIdx + 1}/${rscTotalMatches}`;
                countEl.style.color = '#38bdf8';
            } else {
                countEl.textContent = '0/0';
                countEl.style.color = '#f87171';
            }
        }

        if (prevBtn) prevBtn.disabled = (rscTotalMatches <= 1);
        if (nextBtn) nextBtn.disabled = (rscTotalMatches <= 1);

        if (rscTotalMatches > 0) {
            jumpToMatch(rscCurrentMatchIdx);
        }
    }

    /**
     * Scroll smoothly inside code container to the active match
     */
    function jumpToMatch(index) {
        if (rscTotalMatches === 0) return;

        document.querySelectorAll('.rsc-highlight.rsc-highlight-active').forEach(el => {
            el.classList.remove('rsc-highlight-active');
        });

        const targetMark = document.querySelector(`.rsc-highlight[data-match-idx="${index}"]`);
        if (targetMark) {
            targetMark.classList.add('rsc-highlight-active');
            
            const container = document.getElementById('rscCodeContainer');
            if (container) {
                const containerRect = container.getBoundingClientRect();
                const targetRect = targetMark.getBoundingClientRect();
                const offset = (targetRect.top - containerRect.top) - (container.clientHeight / 2) + (targetRect.height / 2);
                container.scrollBy({ top: offset, behavior: 'smooth' });
            }
        }
    }

    /**
     * Jump to next search match
     */
    function rscNextMatch() {
        if (rscTotalMatches <= 0) return;
        rscCurrentMatchIdx = (rscCurrentMatchIdx + 1) % rscTotalMatches;
        
        // Check if next match is rendered in DOM
        const targetMark = document.querySelector(`.rsc-highlight[data-match-idx="${rscCurrentMatchIdx}"]`);
        if (!targetMark) {
            renderRscContent(document.getElementById('rscSearchInput')?.value || '', true);
        } else {
            updateSearchUI();
        }
    }

    /**
     * Jump to previous search match
     */
    function rscPrevMatch() {
        if (rscTotalMatches <= 0) return;
        rscCurrentMatchIdx = (rscCurrentMatchIdx - 1 + rscTotalMatches) % rscTotalMatches;
        
        // Check if prev match is rendered in DOM
        const targetMark = document.querySelector(`.rsc-highlight[data-match-idx="${rscCurrentMatchIdx}"]`);
        if (!targetMark) {
            renderRscContent(document.getElementById('rscSearchInput')?.value || '', true);
        } else {
            updateSearchUI();
        }
    }

    /**
     * Handle keyboard navigation inside search input
     */
    function handleRscSearchKeyDown(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if (e.shiftKey) {
                rscPrevMatch();
            } else {
                rscNextMatch();
            }
        } else if (e.key === 'Escape') {
            clearRscSearch();
        }
    }

    /**
     * Load all lines if truncated
     */
    function loadAllRscLines() {
        rscMaxLinesRendered = 0; // 0 means no limit
        renderRscContent(document.getElementById('rscSearchInput')?.value || '');
    }

    /**
     * Toggle View Mode between Syntax Highlighting and Raw Text
     */
    function toggleRscViewMode() {
        isRawTextMode = !isRawTextMode;
        const btn = document.getElementById('rscModeToggleBtn');
        const icon = document.getElementById('rscModeIcon');
        const text = document.getElementById('rscModeText');

        if (isRawTextMode) {
            if (btn) {
                btn.classList.add('btn-light', 'text-dark', 'fw-semibold');
                btn.classList.remove('rsc-btn-tool');
            }
            if (icon) icon.className = 'bi bi-palette-fill text-primary';
            if (text) text.textContent = 'Kembali ke Mode Warna';
        } else {
            if (btn) {
                btn.classList.remove('btn-light', 'text-dark', 'fw-semibold');
                btn.classList.add('rsc-btn-tool');
            }
            if (icon) icon.className = 'bi bi-palette text-info';
            if (text) text.textContent = 'Mode Teks Murni';
        }

        renderRscContent(document.getElementById('rscSearchInput')?.value || '');
    }

    /**
     * Search filtering with debounce
     */
    let searchDebounceTimer = null;
    function handleRscSearch(term) {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            renderRscContent(term);
        }, 150);
    }

    function clearRscSearch() {
        const searchInput = document.getElementById('rscSearchInput');
        if (searchInput) {
            searchInput.value = '';
            searchInput.focus();
        }
        renderRscContent('');
    }

    /**
     * Toggle Word Wrap
     */
    function toggleRscWordWrap() {
        const preEl = document.getElementById('rscCodePre');
        const btn = document.getElementById('rscWrapBtn');
        if (!preEl) return;

        isRscWordWrap = !isRscWordWrap;
        if (isRscWordWrap) {
            preEl.classList.add('word-wrap-active');
            if (btn) {
                btn.classList.add('btn-light', 'text-dark', 'fw-semibold');
                btn.classList.remove('rsc-btn-tool');
            }
        } else {
            preEl.classList.remove('word-wrap-active');
            if (btn) {
                btn.classList.remove('btn-light', 'text-dark', 'fw-semibold');
                btn.classList.add('rsc-btn-tool');
            }
        }
    }

    /**
     * Adjust Font Size
     */
    function adjustRscFontSize(delta) {
        currentRscFontSize = Math.max(11, Math.min(22, currentRscFontSize + delta));
        const preEl = document.getElementById('rscCodePre');
        if (preEl) {
            preEl.style.fontSize = `${currentRscFontSize}px`;
        }
    }

    /**
     * Toggle Fullscreen Mode
     */
    function toggleRscFullscreen() {
        const dialog = document.getElementById('rscModalDialog');
        const btn = document.getElementById('rscToggleFullscreenBtn');
        if (!dialog) return;

        isRscFullscreen = !isRscFullscreen;
        if (isRscFullscreen) {
            dialog.classList.add('modal-fullscreen-custom');
            if (btn) btn.innerHTML = '<i class="bi bi-fullscreen-exit fs-6"></i>';
        } else {
            dialog.classList.remove('modal-fullscreen-custom');
            if (btn) btn.innerHTML = '<i class="bi bi-arrows-fullscreen fs-6"></i>';
        }
    }

    /**
     * Copy Script Content to Clipboard
     * ALWAYS copies 100% pure raw script without any HTML tags or parameters.
     */
    function copyRscContent() {
        if (!rawRscScriptContent) return;

        navigator.clipboard.writeText(rawRscScriptContent).then(() => {
            const copyBtn = document.getElementById('rscCopyBtn');
            const copyIcon = document.getElementById('rscCopyIcon');
            const copyText = document.getElementById('rscCopyText');

            if (copyBtn) {
                copyBtn.classList.remove('btn-light');
                copyBtn.classList.add('btn-success');
            }
            if (copyIcon) copyIcon.className = 'bi bi-check2-circle';
            if (copyText) copyText.textContent = 'Script Tersalin!';

            setTimeout(() => {
                if (copyBtn) {
                    copyBtn.classList.remove('btn-success');
                    copyBtn.classList.add('btn-light');
                }
                if (copyIcon) copyIcon.className = 'bi bi-clipboard';
                if (copyText) copyText.textContent = 'Salin Script';
            }, 2000);
        }).catch(() => {
            alert('Gagal menyalin teks ke papan klip.');
        });
    }

    // Keyboard shortcut listener for Ctrl+F inside modal
    document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('rscPreviewModal');
        if (modal && modal.classList.contains('show')) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
                e.preventDefault();
                const searchInput = document.getElementById('rscSearchInput');
                if (searchInput) searchInput.focus();
            }
        }
    });
</script>
