            <!-- Modal Body (Code View) -->
            <div class="modal-body p-0 position-relative" style="background-color: #0b1120; min-height: 480px; max-height: 70vh; overflow-y: auto;" id="rscCodeContainer">
                
                <!-- Loading State -->
                <div id="rscLoadingState" class="d-flex flex-column align-items-center justify-content-center p-5 text-center text-muted" style="min-height: 420px;">
                    <div class="spinner-border text-info mb-3" role="status" style="width: 2.8rem; height: 2.8rem;">
