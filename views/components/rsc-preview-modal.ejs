<!-- RSC Script Preview Modal Component -->
<div class="modal fade" id="rscPreviewModal" tabindex="-1" aria-labelledby="rscPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" id="rscModalDialog">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-dark text-white">
            
            <!-- Modal Header -->
            <div class="modal-header border-bottom border-secondary border-opacity-25 py-3 px-4 bg-slate-900" style="background-color: #0b1120;">
                <div class="d-flex align-items-center gap-3 overflow-hidden me-auto">
                    <span class="badge bg-info-subtle text-info p-2 rounded-3 shrink-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; border: 1px solid rgba(56, 189, 248, 0.25);">
                        <i class="bi bi-file-earmark-code-fill fs-4 text-info"></i>
                    </span>
                    <div class="text-truncate">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h5 class="modal-title font-monospace fw-bold text-white mb-0 text-truncate" id="rscModalFilename">
                                script.rsc
                            </h5>
                            <span class="badge bg-info text-dark text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05em; padding: 0.35em 0.65em;">
                                MikroTik Script (.rsc)
                            </span>
                        </div>
                        <!-- High Contrast Metadata Info Pills -->
                        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap" style="font-size: 0.8rem;">
                            <div class="rsc-info-pill">
                                <i class="bi bi-hdd-network text-info"></i>
                                <span class="rsc-info-label">Router:</span>
                                <strong id="rscModalRouter" class="rsc-info-value">...</strong>
                            </div>
                            <div class="rsc-info-pill" id="rscModalOwnerBadge">
                                <i class="bi bi-person-fill text-primary"></i>
                                <span class="rsc-info-label">Pemilik:</span>
                                <strong id="rscModalOwner" class="rsc-info-value">...</strong>
                            </div>
                            <div class="rsc-info-pill">
                                <i class="bi bi-file-binary text-warning"></i>
                                <span class="rsc-info-label">Ukuran:</span>
                                <strong id="rscModalSize" class="rsc-info-value font-monospace">...</strong>
                            </div>
                            <div class="rsc-info-pill">
                                <i class="bi bi-calendar3 text-success"></i>
                                <span class="rsc-info-label">Tanggal:</span>
                                <strong id="rscModalDate" class="rsc-info-value">...</strong>
                            </div>
                            <div class="rsc-info-pill">
                                <i class="bi bi-list-ol text-info"></i>
                                <span class="rsc-info-label">Total:</span>
                                <strong id="rscModalLines" class="rsc-info-value text-info font-monospace">...</strong>
                                <span class="rsc-info-label">baris</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 ms-2">
                    <button type="button" class="btn btn-sm rsc-btn-tool p-1.5 rounded-2" id="rscToggleFullscreenBtn" onclick="toggleRscFullscreen()" title="Layar Penuh (Toggle Fullscreen)">
                        <i class="bi bi-arrows-fullscreen fs-6"></i>
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Toolbar Controls -->
            <div class="px-4 py-2.5 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: #0f172a;">
                <!-- Left: Search Box (Clear, High-Contrast & Interactive Navigation) -->
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm rsc-search-box" style="width: 320px;">
                        <span class="input-group-text rsc-search-icon">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="rscSearchInput" class="form-control form-control-sm rsc-search-input" 
                               placeholder="Cari dalam script... (Ctrl+F)" 
                               oninput="handleRscSearch(this.value)" 
                               onkeydown="handleRscSearchKeyDown(event)"
                               autocomplete="off" spellcheck="false">
                        <span id="rscSearchCount" class="input-group-text rsc-search-count d-none">
                            0/0
                        </span>
                        <button class="btn btn-sm rsc-search-btn" type="button" id="rscSearchPrevBtn" onclick="rscPrevMatch()" title="Sebelumnya (Shift+Enter)" disabled>
                            <i class="bi bi-chevron-up"></i>
                        </button>
                        <button class="btn btn-sm rsc-search-btn" type="button" id="rscSearchNextBtn" onclick="rscNextMatch()" title="Berikutnya (Enter)" disabled>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <button class="btn btn-sm rsc-search-btn" type="button" id="rscSearchClearBtn" onclick="clearRscSearch()" title="Bersihkan pencarian (Esc)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Right: Viewing Options & Actions -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <!-- Mode Toggle: Highlight vs Raw Text -->
                    <button type="button" class="btn btn-sm rsc-btn-tool rounded-2 d-inline-flex align-items-center gap-1.5" id="rscModeToggleBtn" onclick="toggleRscViewMode()" title="Beralih antara mode Syntax Highlighting dan Mode Teks Murni">
                        <i class="bi bi-palette text-info" id="rscModeIcon"></i> <span id="rscModeText">Mode Teks Murni</span>
                    </button>

                    <!-- Wrap Lines -->
                    <button type="button" class="btn btn-sm rsc-btn-tool rounded-2 d-inline-flex align-items-center gap-1.5" id="rscWrapBtn" onclick="toggleRscWordWrap()" title="Bungkus teks panjang (Word Wrap)">
                        <i class="bi bi-text-wrap text-warning"></i> <span class="d-none d-sm-inline">Wrap</span>
                    </button>

                    <!-- Font Sizing -->
                    <div class="btn-group btn-group-sm" role="group" aria-label="Font sizing">
                        <button type="button" class="btn rsc-btn-tool" onclick="adjustRscFontSize(-1)" title="Perkecil Font">
                            <i class="bi bi-dash"></i> A
                        </button>
                        <button type="button" class="btn rsc-btn-tool" onclick="adjustRscFontSize(1)" title="Perbesar Font">
                            <i class="bi bi-plus"></i> A
                        </button>
                    </div>

                    <!-- Copy All (Pristine original content) -->
                    <button type="button" class="btn btn-sm btn-light fw-bold text-dark rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3" id="rscCopyBtn" onclick="copyRscContent()" title="Salin seluruh isi script murni (100% siap import ke MikroTik)">
                        <i class="bi bi-clipboard" id="rscCopyIcon"></i> <span id="rscCopyText">Salin Script</span>
                    </button>

                    <!-- Download File -->
                    <a href="#" id="rscDownloadBtn" class="btn btn-sm btn-primary fw-bold rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3" title="Unduh berkas .rsc">
                        <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Unduh File</span>
                    </a>
                </div>
            </div>

            <!-- Optional Large File Banner -->
            <div id="rscTruncatedBanner" class="d-none alert alert-info py-2 px-4 m-0 border-0 rounded-0 small d-flex align-items-center justify-content-between" style="background-color: #0c4a6e; color: #bae6fd;">
                <div>
                    <i class="bi bi-info-circle-fill me-1 text-info"></i>
                    Menampilkan <span id="rscDisplayedLinesCount">2.500</span> baris pertama untuk performa cepat (Total: <span id="rscTotalLinesBanner">0</span> baris).
                    Tombol <strong>"Salin Script"</strong> & <strong>"Unduh File"</strong> tetap menyalin/mengunduh 100% seluruh script lengkap.
                </div>
                <button type="button" class="btn btn-xs btn-outline-light py-0.5 px-2 ms-2 rounded-2" onclick="loadAllRscLines()">
                    Muat Seluruh Baris
                </button>
