<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Admin Dashboard</h3>
        <p class="text-muted small mb-0">Pantau status kesehatan router, tren backup berkas, dan aktivitas sistem secara terpusat.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/routers" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-router"></i>
            <span>Semua Router</span>
        </a>
        <a href="/routers/create" class="btn btn-primary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-plus-lg"></i>
            <span>Tambah Router</span>
        </a>
    </div>
</div>

<!-- Metrics Summary (Clean & Minimalist - matching Retensi & Storage) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Router</div>
            <h4 class="fw-bold text-dark mb-0"><%= totalRouters %> <span class="fs-6 fw-normal text-muted">unit (<%= totalUsers %> tenant)</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Router Sehat (&lt; 24 Jam)</div>
            <h4 class="fw-bold text-dark mb-0"><%= healthyRoutersCount %> <span class="fs-6 fw-normal text-muted">/ <%= totalRouters %> normal</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Perlu Perhatian (&gt; 24 Jam)</div>
            <h4 class="fw-bold <%= failedRoutersCount > 0 ? 'text-danger' : 'text-dark' %> mb-0">
                <%= failedRoutersCount %> <span class="fs-6 fw-normal <%= failedRoutersCount > 0 ? 'text-danger' : 'text-muted' %>"><%= failedRoutersCount > 0 ? 'terlambat' : 'kondisi normal' %></span>
            </h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Storage Server</div>
            <h4 class="fw-bold text-dark mb-0"><%= totalSizeFormatted %> <span class="fs-6 fw-normal text-muted">/ <%= totalBackups %> berkas</span></h4>
        </div>
    </div>
</div>

<!-- Server & Service Health Monitor (Kesehatan Server & Layanan Terpusat) -->
<% if (typeof serverHealth !== 'undefined' && serverHealth) { %>
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-heart-pulse text-danger"></i>
            <h5 class="fw-bold mb-0 text-dark">Kesehatan Server & Layanan (Health Monitor)</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-muted border small d-inline-flex align-items-center gap-1">
                <i class="bi bi-clock"></i> Uptime: <%= serverHealth.system.uptime %>
            </span>
            <a href="/admin/logs" class="btn btn-sm btn-outline-primary rounded-2 py-0.5 px-2.5" style="font-size: 0.78rem;">
                <i class="bi bi-journal-text me-1"></i>Audit Log
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <!-- 1. Daemon FTP Listener -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="p-3 rounded-3 border bg-light-subtle h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-hdd-rack text-primary fs-5"></i>
                            <span class="fw-bold text-dark small">Daemon FTP MikroTik</span>
                        </div>
                        <% if (serverHealth.ftp.status === 'online') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle-fill me-1"></i>Online (<%= serverHealth.ftp.latency %>ms)
                            </span>
                        <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i>Offline
                            </span>
                        <% } %>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.78rem;">
                        Port: <strong class="text-dark font-monospace"><%= serverHealth.ftp.port %></strong> / TCP
                    </div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem;">
                        <%= serverHealth.ftp.message %>
                    </div>
                </div>
            </div>

            <!-- 2. Penyimpanan Hardisk VPS -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="p-3 rounded-3 border bg-light-subtle h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-pie-chart text-info fs-5"></i>
                            <span class="fw-bold text-dark small">Hardisk Penyimpanan</span>
                        </div>
                        <span class="badge <%= serverHealth.disk.percentUsed > 90 ? 'bg-danger-subtle text-danger border border-danger-subtle' : (serverHealth.disk.percentUsed > 80 ? 'bg-warning-subtle text-warning border border-warning-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle') %> rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                            <%= serverHealth.disk.percentUsed %>% Digunakan
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center text-secondary small mb-1.5" style="font-size: 0.76rem;">
                        <span><%= serverHealth.disk.usedFormatted %> terpakai</span>
                        <span class="text-muted"><%= serverHealth.disk.freeFormatted %> kosong</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar <%= serverHealth.disk.percentUsed > 90 ? 'bg-danger' : (serverHealth.disk.percentUsed > 80 ? 'bg-warning' : 'bg-primary') %>" role="progressbar" style="width: <%= serverHealth.disk.percentUsed %>%;" aria-valuenow="<%= serverHealth.disk.percentUsed %>" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted mt-1.5" style="font-size: 0.72rem;">
                        Total Kapasitas Partisi: <strong class="text-dark"><%= serverHealth.disk.totalFormatted %></strong>
                    </div>
                </div>
            </div>

            <!-- 3. Database MySQL -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="p-3 rounded-3 border bg-light-subtle h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-database text-success fs-5"></i>
                            <span class="fw-bold text-dark small">Koneksi Database</span>
                        </div>
                        <% if (serverHealth.database.status === 'online') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle-fill me-1"></i><%= serverHealth.database.latency %>ms
                            </span>
                        <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Terputus
                            </span>
                        <% } %>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.78rem;">
                        Data: <strong class="text-dark"><%= serverHealth.database.stats.routers %></strong> router, <strong class="text-dark"><%= serverHealth.database.stats.backups %></strong> file
                    </div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem;">
                        <%= serverHealth.database.message %>
                    </div>
                </div>
            </div>

            <!-- 4. Background Daemon & Retensi -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="p-3 rounded-3 border bg-light-subtle h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-warning fs-5"></i>
                            <span class="fw-bold text-dark small">Retensi & Auto-Prune</span>
                        </div>
                        <span class="badge <%= serverHealth.system.retention.autoPruneEnabled ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border' %> rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                            <%= serverHealth.system.retention.autoPruneEnabled ? 'Cron 00:00 Aktif' : 'Manual' %>
                        </span>
                    </div>
                    <div class="text-secondary small" style="font-size: 0.78rem;">
                        RAM RSS: <strong class="text-dark"><%= serverHealth.system.memoryRss %></strong>
                    </div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem;">
                        Terakhir Prune: <%= diffForHumans(serverHealth.system.retention.lastPrunedAt) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Charts Section: Backup Trends & System Composition -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Tren Aktivitas Backup (7 Hari Terakhir) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Tren Aktivitas Backup</h5>
                </div>
                <span class="badge bg-light text-muted border small">Rentang 7 Hari Terakhir</span>
            </div>
            <div class="card-body p-4">
                <div style="height: 250px; position: relative;">
                    <canvas id="backupTrendsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Komposisi File & Penyimpanan -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Distribusi Berkas</h5>
                </div>
                <span class="badge bg-light text-muted border small"><%= totalBackups %> Berkas</span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div style="height: 175px; position: relative;">
                    <canvas id="storageCompositionChart"></canvas>
                </div>
                <div class="pt-3 border-top border-light mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #0284c7;"></span>
                            <span class="fw-semibold text-dark">Script (.rsc)</span>
                        </div>
                        <span class="small font-monospace text-muted"><%= chartData.rscCount %> berkas (<%= chartData.rscFormatted %>)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #64748b;"></span>
                            <span class="fw-semibold text-dark">Binary (.backup)</span>
                        </div>
                        <span class="small font-monospace text-muted"><%= chartData.binaryCount %> berkas (<%= chartData.binaryFormatted %>)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row: Router Perlu Perhatian & Aktivitas Terbaru -->
<div class="row g-4">
    <!-- Problem Routers Section -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    <h5 class="fw-bold mb-0 text-dark">Router Perlu Perhatian (&gt; 24 Jam)</h5>
                </div>
                <span class="badge <%= problemRouters.length > 0 ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-light text-muted border' %> rounded-pill px-2.5 py-0.5 small">
                    <%= problemRouters.length %> Router
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4 py-2.5">Router & Pemilik</th>
                            <th class="py-2.5">Terakhir Backup</th>
                            <th class="text-end pe-4 py-2.5">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (problemRouters.length > 0) { %>
                            <% problemRouters.forEach(function(router) { %>
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-hdd-network text-secondary"></i>
                                            <div>
                                                <strong class="text-dark"><%= router.name %></strong>
                                                <div class="small text-muted" style="font-size: 0.78rem;">
                                                    Pemilik: <%= router.owner_name || 'N/A' %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-2.5">
                                        <% if (router.last_backup_time) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold"><%= diffForHumans(router.last_backup_time) %></span>
                                            <div class="text-muted" style="font-size: 0.72rem;"><%= formatDate(router.last_backup_time) %> WIB</div>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary border">Belum Pernah</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4 py-2.5">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/routers/<%= router.id %>" class="btn btn-sm btn-light border" title="Lihat Router & Script">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <% if (router.user_id) { %>
                                                <form action="/admin/users/<%= router.user_id %>/impersonate" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-light border text-warning" title="Impersonate Akun Tenant">
                                                        <i class="bi bi-person-fill-gear"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-center">
                                        <div class="badge bg-success-subtle text-success p-3 rounded-circle mb-2">
                                            <i class="bi bi-shield-check fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Semua Router Beroperasi Normal</h6>
                                        <p class="text-muted small mb-0">Tidak ada router yang mengalami keterlambatan backup lebih dari 24 jam.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent System-Wide Activity -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Aktivitas Backup Masuk (Global)</h5>
                </div>
                <span class="badge bg-light text-muted border small">
                    <%= recentBackups.length %> Terbaru
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4 py-2.5">Waktu</th>
                            <th class="py-2.5">Router & Pemilik</th>
                            <th class="py-2.5">Tipe & Ukuran</th>
                            <th class="text-end pe-4 py-2.5">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentBackups.length > 0) { %>
                            <% recentBackups.forEach(function(backup) { %>
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;"><%= formatDate(backup.created_at, 'HH:mm') %> WIB</div>
                                        <small class="text-muted" style="font-size: 0.72rem;"><%= diffForHumans(backup.created_at) %></small>
                                    </td>
                                    <td class="py-2.5">
                                        <strong class="text-dark"><%= backup.router_name || 'Router Dihapus' %></strong>
                                        <div class="small text-muted" style="font-size: 0.78rem;"><%= backup.owner_name || 'N/A' %></div>
                                    </td>
                                    <td class="py-2.5">
                                        <span class="badge <%= backup.file_type === 'rsc' ? 'bg-info-subtle text-info border border-info-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> text-uppercase fw-semibold" style="font-size: 0.68rem;">
                                            .<%= backup.file_type %>
                                        </span>
                                        <span class="text-muted ms-1" style="font-size: 0.8rem;"><%= formatBytes(backup.file_size) %></span>
                                    </td>
                                    <td class="text-end pe-4 py-2.5">
                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                            <% if (backup.file_type === 'rsc') { %>
                                                <a href="/backup/preview/<%= backup.id %>" class="btn btn-sm btn-info text-white rounded-2 py-1 px-2 d-inline-flex align-items-center gap-1 shadow-sm" onclick="openRscPreview(<%= backup.id %>); return false;" title="Lihat Isi Script (.rsc)">
                                                    <i class="bi bi-file-earmark-code"></i> <span class="d-none d-xl-inline">Lihat Isi</span>
                                                </a>
                                            <% } %>
                                            <a href="/backup/download/<%= backup.id %>" class="btn btn-sm btn-light border text-success rounded-2 py-1 px-2" title="Unduh File Backup">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-center">
                                        <div class="badge bg-secondary-subtle text-secondary p-3 rounded-circle mb-2">
                                            <i class="bi bi-inbox fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Belum Ada Aktivitas Backup</h6>
                                        <p class="text-muted small mb-0">File backup yang dikirimkan router MikroTik via API akan tampil di sini secara realtime.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Log Sistem & Audit Terbaru Section -->
<div class="card border-0 shadow-sm rounded-3 mt-4 mb-4">
    <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-journal-text text-primary"></i>
            <h5 class="fw-bold mb-0 text-dark">Log Sistem & Audit Terbaru</h5>
        </div>
        <a href="/admin/logs" class="btn btn-sm btn-outline-primary rounded-2 px-3 d-inline-flex align-items-center gap-1.5 shadow-sm">
            <span>Buka Halaman Audit Lengkap</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                <tr>
                    <th class="ps-4 py-2.5" style="width: 160px;">Waktu</th>
                    <th class="py-2.5" style="width: 120px;">Kategori</th>
                    <th class="py-2.5" style="width: 90px;">Status</th>
                    <th class="py-2.5">Aksi & Deskripsi</th>
                    <th class="py-2.5" style="width: 180px;">Entitas Terkait</th>
                    <th class="pe-4 py-2.5 text-end" style="width: 130px;">IP Address</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof recentLogs !== 'undefined' && recentLogs && recentLogs.length > 0) { %>
                    <% recentLogs.forEach(function(item) { %>
                        <tr>
                            <td class="ps-4 py-2.5">
                                <div class="fw-semibold text-dark"><%= formatDate(item.created_at, 'HH:mm:ss') %> WIB</div>
                                <small class="text-muted" style="font-size: 0.72rem;"><%= diffForHumans(item.created_at) %></small>
                            </td>
                            <td class="py-2.5">
                                <% if (item.type === 'ftp_upload') { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-cloud-arrow-up"></i> FTP_UP
                                    </span>
                                <% } else if (item.type === 'ftp_error') { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-exclamation-octagon"></i> FTP_ERR
                                    </span>
                                <% } else if (item.type === 'backup') { %>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-archive"></i> BACKUP
                                    </span>
                                <% } else if (item.type === 'auth') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-key"></i> AUTH
                                    </span>
                                <% } else if (item.type === 'impersonate') { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-person-fill-gear"></i> IMPERSON
                                    </span>
                                <% } else if (item.type === 'retention') { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-trash"></i> RETENSI
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">
                                        <i class="bi bi-cpu"></i> SISTEM
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-2.5">
                                <% if (item.status === 'success') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Sukses</span>
                                <% } else if (item.status === 'error') { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Gagal</span>
                                <% } else if (item.status === 'warning') { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Perhatian</span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Info</span>
                                <% } %>
                            </td>
                            <td class="py-2.5">
                                <strong class="text-dark"><%= item.action %></strong>
                                <div class="text-secondary small text-truncate" style="max-width: 450px;">
                                    <%= item.description %>
                                </div>
                            </td>
                            <td class="py-2.5">
                                <% if (item.router_name) { %>
                                    <div class="text-dark fw-semibold small">
                                        <i class="bi bi-hdd-network text-primary"></i> <%= item.router_name %>
                                    </div>
                                <% } %>
                                <% if (item.user_name) { %>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="bi bi-person"></i> <%= item.user_name %>
                                    </div>
                                <% } %>
                                <% if (!item.router_name && !item.user_name) { %>
                                    <span class="text-muted small">—</span>
                                <% } %>
                            </td>
                            <td class="pe-4 py-2.5 text-end font-monospace small">
                                <%= item.ip_address || '—' %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted small">
                            <i class="bi bi-journal-x me-1"></i> Belum ada aktivitas sistem yang tercatat.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Chart Scripts Initialization -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chartData = <%- JSON.stringify(chartData) %>;

    // 1. Line Chart: 7-Day Backup Trends
    const trendsCtx = document.getElementById('backupTrendsChart');
    if (trendsCtx && typeof Chart !== 'undefined') {
        const ctx = trendsCtx.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 240);
        gradient.addColorStop(0, 'rgba(2, 132, 199, 0.22)');
        gradient.addColorStop(1, 'rgba(2, 132, 199, 0.01)');

        new Chart(trendsCtx, {
            type: 'line',
            data: {
                labels: chartData.trendLabels || [],
                datasets: [{
                    label: 'Jumlah Berkas Backup',
                    data: chartData.trendCounts || [],
                    borderColor: '#0284c7',
                    borderWidth: 2.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#0284c7',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { size: 12, weight: '600' },
                        bodyFont: { size: 12 },
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const index = context.dataIndex;
                                const count = context.parsed.y;
                                const size = chartData.trendSizes[index] || 0;
                                return ` ${count} Berkas (${size} KB)`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748b',
                            font: { size: 11 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: '#64748b',
                            font: { size: 11 }
                        },
                        grid: {
                            color: '#f1f5f9',
                            drawBorder: false
                        }
                    }
                }
            }
        });
    }

    // 2. Doughnut Chart: Storage & File Composition
    const compCtx = document.getElementById('storageCompositionChart');
    if (compCtx && typeof Chart !== 'undefined') {
        const totalFiles = (chartData.rscCount || 0) + (chartData.binaryCount || 0);
        const dataValues = totalFiles > 0 
            ? [chartData.rscCount || 0, chartData.binaryCount || 0]
            : [1];
        const bgColors = totalFiles > 0 
            ? ['#0284c7', '#64748b']
            : ['#e2e8f0'];

        new Chart(compCtx, {
            type: 'doughnut',
            data: {
                labels: totalFiles > 0 ? ['Script (.rsc)', 'Binary (.backup)'] : ['Belum Ada Berkas'],
                datasets: [{
                    data: dataValues,
                    backgroundColor: bgColors,
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        enabled: totalFiles > 0,
                        backgroundColor: '#0f172a',
                        titleFont: { size: 12, weight: '600' },
                        bodyFont: { size: 12 },
                        padding: 10,
                        cornerRadius: 8
                    }
                }
            }
        });
    }
});
</script>