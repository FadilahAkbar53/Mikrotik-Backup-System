<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start align-items-md-center mb-4 flex-column flex-md-row gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Admin Dashboard</h3>
        <p class="text-muted small mb-0">Pantau status kesehatan router, tren backup berkas, dan aktivitas sistem secara terpusat.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/routers" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-router"></i>
            <span>Semua Router</span>
        </a>
        <a href="/routers/create" class="btn btn-primary btn-sm rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm px-3">
            <i class="bi bi-plus-lg"></i>
            <span>Tambah Router</span>
        </a>
    </div>
</div>

<!-- Metrics Summary (Clean & Minimalist - matching Retensi & Storage) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Total Router</div>
            <h4 class="fw-bold text-dark mb-0"><%= totalRouters %> <span class="fs-6 fw-normal text-muted">unit (<%= totalUsers %> tenant)</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Router Sehat (&lt; 24 Jam)</div>
            <h4 class="fw-bold text-dark mb-0"><%= healthyRoutersCount %> <span class="fs-6 fw-normal text-muted">/ <%= totalRouters %> normal</span></h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Perlu Perhatian (&gt; 24 Jam)</div>
            <h4 class="fw-bold <%= failedRoutersCount > 0 ? 'text-danger' : 'text-dark' %> mb-0">
                <%= failedRoutersCount %> <span class="fs-6 fw-normal <%= failedRoutersCount > 0 ? 'text-danger' : 'text-muted' %>"><%= failedRoutersCount > 0 ? 'terlambat' : 'kondisi normal' %></span>
            </h4>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-muted small text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.03em;">Storage Server</div>
            <h4 class="fw-bold text-dark mb-0"><%= totalSizeFormatted %> <span class="fs-6 fw-normal text-muted">/ <%= totalBackups %> berkas</span></h4>
        </div>
    </div>
</div>

<!-- Charts Section: Backup Trends & System Composition -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Tren Aktivitas Backup (7 Hari Terakhir) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Tren Aktivitas Backup</h5>
                </div>
                <span class="badge bg-light text-muted border small">Rentang 7 Hari Terakhir</span>
            </div>
            <div class="card-body p-4">
                <div style="height: 250px; position: relative;">
                    <canvas id="backupTrendsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Komposisi File & Penyimpanan -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Distribusi Berkas</h5>
                </div>
                <span class="badge bg-light text-muted border small"><%= totalBackups %> Berkas</span>
            </div>
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div style="height: 175px; position: relative;">
                    <canvas id="storageCompositionChart"></canvas>
                </div>
                <div class="pt-3 border-top border-light mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #0284c7;"></span>
                            <span class="fw-semibold text-dark">Script (.rsc)</span>
                        </div>
                        <span class="small font-monospace text-muted"><%= chartData.rscCount %> berkas (<%= chartData.rscFormatted %>)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: #64748b;"></span>
                            <span class="fw-semibold text-dark">Binary (.backup)</span>
                        </div>
                        <span class="small font-monospace text-muted"><%= chartData.binaryCount %> berkas (<%= chartData.binaryFormatted %>)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row: Router Perlu Perhatian & Aktivitas Terbaru -->
<div class="row g-4">
    <!-- Problem Routers Section -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    <h5 class="fw-bold mb-0 text-dark">Router Perlu Perhatian (&gt; 24 Jam)</h5>
                </div>
                <span class="badge <%= problemRouters.length > 0 ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-light text-muted border' %> rounded-pill px-2.5 py-0.5 small">
                    <%= problemRouters.length %> Router
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4 py-2.5">Router & Pemilik</th>
                            <th class="py-2.5">Terakhir Backup</th>
                            <th class="text-end pe-4 py-2.5">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (problemRouters.length > 0) { %>
                            <% problemRouters.forEach(function(router) { %>
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-hdd-network text-secondary"></i>
                                            <div>
                                                <strong class="text-dark"><%= router.name %></strong>
                                                <div class="small text-muted" style="font-size: 0.78rem;">
                                                    Pemilik: <%= router.owner_name || 'N/A' %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-2.5">
                                        <% if (router.last_backup_time) { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold"><%= diffForHumans(router.last_backup_time) %></span>
                                            <div class="text-muted" style="font-size: 0.72rem;"><%= formatDate(router.last_backup_time) %> WIB</div>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary border">Belum Pernah</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4 py-2.5">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/routers/<%= router.id %>" class="btn btn-sm btn-light border" title="Lihat Router & Script">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <% if (router.user_id) { %>
                                                <form action="/admin/users/<%= router.user_id %>/impersonate" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-light border text-warning" title="Impersonate Akun Tenant">
                                                        <i class="bi bi-person-fill-gear"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <div class="text-center">
                                        <div class="badge bg-success-subtle text-success p-3 rounded-circle mb-2">
                                            <i class="bi bi-shield-check fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Semua Router Beroperasi Normal</h6>
                                        <p class="text-muted small mb-0">Tidak ada router yang mengalami keterlambatan backup lebih dari 24 jam.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent System-Wide Activity -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom border-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <h5 class="fw-bold mb-0 text-dark">Aktivitas Backup Masuk (Global)</h5>
                </div>
                <span class="badge bg-light text-muted border small">
                    <%= recentBackups.length %> Terbaru
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light text-muted small text-uppercase" style="font-size: 0.72rem;">
                        <tr>
                            <th class="ps-4 py-2.5">Waktu</th>
                            <th class="py-2.5">Router & Pemilik</th>
                            <th class="py-2.5">Tipe & Ukuran</th>
                            <th class="text-end pe-4 py-2.5">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentBackups.length > 0) { %>
                            <% recentBackups.forEach(function(backup) { %>
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;"><%= formatDate(backup.created_at, 'HH:mm') %> WIB</div>
                                        <small class="text-muted" style="font-size: 0.72rem;"><%= diffForHumans(backup.created_at) %></small>
                                    </td>
                                    <td class="py-2.5">
                                        <strong class="text-dark"><%= backup.router_name || 'Router Dihapus' %></strong>
                                        <div class="small text-muted" style="font-size: 0.78rem;"><%= backup.owner_name || 'N/A' %></div>
                                    </td>
                                    <td class="py-2.5">
                                        <span class="badge <%= backup.file_type === 'rsc' ? 'bg-info-subtle text-info border border-info-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> text-uppercase fw-semibold" style="font-size: 0.68rem;">
                                            .<%= backup.file_type %>
                                        </span>
                                        <span class="text-muted ms-1" style="font-size: 0.8rem;"><%= formatBytes(backup.file_size) %></span>
                                    </td>
                                    <td class="text-end pe-4 py-2.5">
                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                            <% if (backup.file_type === 'rsc') { %>
                                                <a href="/backup/preview/<%= backup.id %>" class="btn btn-sm btn-info text-white rounded-2 py-1 px-2 d-inline-flex align-items-center gap-1 shadow-sm" onclick="openRscPreview(<%= backup.id %>); return false;" title="Lihat Isi Script (.rsc)">
                                                    <i class="bi bi-file-earmark-code"></i> <span class="d-none d-xl-inline">Lihat Isi</span>
                                                </a>
                                            <% } %>
                                            <a href="/backup/download/<%= backup.id %>" class="btn btn-sm btn-light border text-success rounded-2 py-1 px-2" title="Unduh File Backup">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-center">
                                        <div class="badge bg-secondary-subtle text-secondary p-3 rounded-circle mb-2">
                                            <i class="bi bi-inbox fs-2"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Belum Ada Aktivitas Backup</h6>
                                        <p class="text-muted small mb-0">File backup yang dikirimkan router MikroTik via API akan tampil di sini secara realtime.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart Scripts Initialization -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chartData = <%- JSON.stringify(chartData) %>;

    // 1. Line Chart: 7-Day Backup Trends
    const trendsCtx = document.getElementById('backupTrendsChart');
    if (trendsCtx && typeof Chart !== 'undefined') {
        const ctx = trendsCtx.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 240);
        gradient.addColorStop(0, 'rgba(2, 132, 199, 0.22)');
        gradient.addColorStop(1, 'rgba(2, 132, 199, 0.01)');

        new Chart(trendsCtx, {
            type: 'line',
            data: {
                labels: chartData.trendLabels || [],
                datasets: [{
                    label: 'Jumlah Berkas Backup',
                    data: chartData.trendCounts || [],
                    borderColor: '#0284c7',
                    borderWidth: 2.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#0284c7',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { size: 12, weight: '600' },
                        bodyFont: { size: 12 },
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const index = context.dataIndex;
                                const count = context.parsed.y;
                                const size = chartData.trendSizes[index] || 0;
                                return ` ${count} Berkas (${size} KB)`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748b',
                            font: { size: 11 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: '#64748b',
                            font: { size: 11 }
                        },
                        grid: {
                            color: '#f1f5f9',
                            drawBorder: false
                        }
                    }
                }
            }
        });
    }

    // 2. Doughnut Chart: Storage & File Composition
    const compCtx = document.getElementById('storageCompositionChart');
    if (compCtx && typeof Chart !== 'undefined') {
        const totalFiles = (chartData.rscCount || 0) + (chartData.binaryCount || 0);
        const dataValues = totalFiles > 0 
            ? [chartData.rscCount || 0, chartData.binaryCount || 0]
            : [1];
        const bgColors = totalFiles > 0 
            ? ['#0284c7', '#64748b']
            : ['#e2e8f0'];

        new Chart(compCtx, {
            type: 'doughnut',
            data: {
                labels: totalFiles > 0 ? ['Script (.rsc)', 'Binary (.backup)'] : ['Belum Ada Berkas'],
                datasets: [{
                    data: dataValues,
                    backgroundColor: bgColors,
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        enabled: totalFiles > 0,
                        backgroundColor: '#0f172a',
                        titleFont: { size: 12, weight: '600' },
                        bodyFont: { size: 12 },
                        padding: 10,
                        cornerRadius: 8
                    }
                }
            }
        });
    }
});
</script>