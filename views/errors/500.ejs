<% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <div class="row justify-content-center py-5">
        <div class="col-md-7 text-center">
            <div class="card p-5 shadow-sm border-0 rounded-4">
                <div class="mb-3">
                    <span class="badge bg-danger-subtle text-danger p-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                        <i class="bi bi-exclamation-octagon-fill fs-1"></i>
                    </span>
                </div>
                <h1 class="fw-bold mb-2 text-danger">500</h1>
                <h4 class="fw-semibold text-dark mb-2">Terjadi Kesalahan Server</h4>
                <p class="text-muted mb-4">
                    <%= typeof message !== 'undefined' && message ? message : 'Sistem mengalami kendala tak terduga saat memproses permintaan Anda. Tim administrator telah diberitahu mengenai kejadian ini.' %>
                </p>

                <% if (typeof error !== 'undefined' && error && typeof isDev !== 'undefined' && isDev) { %>
                    <div class="text-start mb-4">
                        <button class="btn btn-sm btn-outline-secondary w-100 mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#debugStackTrace">
                            <i class="bi bi-bug me-1"></i> Mode Pengembangan: Tampilkan Detail Error (Debug)
                        </button>
                        <div class="collapse" id="debugStackTrace">
                            <pre class="bg-dark text-warning p-3 rounded-3 small overflow-auto" style="max-height: 250px;"><code><%= error.stack || error.message || error %></code></pre>
                        </div>
                    </div>
                <% } %>

                <div class="d-flex justify-content-center gap-2">
                    <a href="javascript:history.back()" class="btn btn-light rounded-3 px-4 border">
                        <i class="bi bi-arrow-left me-1"></i> Kembali
                    </a>
                    <a href="/dashboard" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-house-door me-1"></i> Dashboard Utama
                    </a>
                </div>
            </div>
        </div>
    </div>
<% } else { %>
    <!DOCTYPE html>
    <html lang="id">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>500 - Terjadi Kesalahan Server</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
            body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
            .error-card { text-align: center; max-width: 500px; width: 90%; padding: 2.5rem; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
        </style>
    </head>
    <body>
        <div class="error-card">
            <span class="badge bg-danger-subtle text-danger p-3 rounded-circle mb-3 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                <i class="bi bi-exclamation-octagon-fill fs-2"></i>
            </span>
            <h1 class="fw-bold mb-2 text-white">500</h1>
            <h5 class="text-white mb-2">Terjadi Kesalahan Server</h5>
            <p class="text-secondary small mb-4">
                <%= typeof message !== 'undefined' && message ? message : 'Sistem mengalami kesalahan internal saat memproses data. Silakan muat ulang halaman atau hubungi administrator jika masalah terus berlanjut.' %>
            </p>

            <% if (typeof error !== 'undefined' && error && typeof isDev !== 'undefined' && isDev) { %>
                <div class="text-start mb-3">
                    <pre class="bg-black text-warning p-2 rounded small overflow-auto" style="max-height: 180px; font-size: 0.75rem;"><code><%= error.stack || error.message || error %></code></pre>
                </div>
            <% } %>

            <div class="d-grid gap-2">
                <a href="javascript:location.reload()" class="btn btn-primary py-2.5 rounded-3 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i> Muat Ulang Halaman
                </a>
                <a href="/login" class="btn btn-outline-light py-2 rounded-3 small">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ke Halaman Login
                </a>
            </div>
        </div>
    </body>
    </html>
<% } %>
